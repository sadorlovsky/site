    "@libsql/client": "^0.18",
    "@simplewebauthn/browser": "^14",
    "@simplewebauthn/server": "^14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "astro-expressive-code": "^0.44.3",
    "astro-icon": "^1.2.0",
    "astro-seo": "^1.2.0",
    "aws4fetch": "^1.0.20",
