---
import PageLayout from "@layouts/PageLayout.astro";
import Button from "@components/kit/Button.astro";
import ToggleGroup from "@components/kit/ToggleGroup.astro";
import Select from "@components/kit/Select.astro";
import Input from "@components/kit/Input.astro";
import Checkbox from "@components/kit/Checkbox.astro";
import Badge from "@components/kit/Badge.astro";
import ProgressBar from "@components/kit/ProgressBar.astro";
import "@styles/kit/modal.css";
import "@styles/kit/toast.css";
import { Icon } from "astro-icon/components";
---

<PageLayout title="UI Kit">
  <div class="kit-layout">
    <aside class="kit-sidebar">
      <nav class="kit-nav">
        <div class="kit-nav-section">
          <h3>Foundations</h3>
          <ul>
            <li><a href="#colors">Colors</a></li>
            <li><a href="#liquid-glass">Liquid glass</a></li>
            <li><a href="#typography">Typography</a></li>
            <li><a href="#links">Links</a></li>
          </ul>
        </div>
        <div class="kit-nav-section">
          <h3>Components</h3>
          <ul>
            <li><a href="#button">Button</a></li>
            <li><a href="#toggle-group">ToggleGroup</a></li>
            <li><a href="#select">Select</a></li>
            <li><a href="#input">Input</a></li>
            <li><a href="#checkbox">Checkbox</a></li>
            <li><a href="#badge">Badge</a></li>
            <li><a href="#progress-bar">ProgressBar</a></li>
            <li><a href="#modal">Modal</a></li>
            <li><a href="#toast">Toast</a></li>
          </ul>
        </div>
        <div class="kit-nav-section">
          <h3>Utilities</h3>
          <ul>
            <li><a href="#tooltips">Tooltips</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <main id="main" class="kit-content">
      <h1>UI Kit</h1>
      <p class="kit-intro">Design system for this site. Colors, typography, and reusable components.</p>

      <!-- ================================================================
           COLORS
           ================================================================ -->
      <section id="colors">
        <h2>Colors</h2>

        <h3>Background</h3>
        <div class="color-grid">
          <div class="color-swatch">
            <div class="swatch" style="background: #191919;"></div>
            <div class="color-info">
              <code>--dark-bg</code>
              <span class="color-value">#191919</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: #f8f8ff;"></div>
            <div class="color-info">
              <code>--light-bg</code>
              <span class="color-value">#f8f8ff</span>
            </div>
          </div>
        </div>

        <h3>Accent</h3>
        <p class="section-note">
          The accent stays bright and its label goes dark — never the other way
          round. White on this gradient is 3.07:1 against the 4.5 a button
          label needs, and dimming the accent to fix that would cost the brand
          its brightness on every primary action at once. The stops sit 45°
          apart in hue so the sweep reads as a gradient even on a word as short
          as <em>Zach</em>. The deep pair exists for one job only: being small
          text on the light page, where nothing but the accent can darken.
        </p>
        <div class="color-grid">
          <div class="color-swatch">
            <div class="swatch swatch--ink" style="background: var(--accent-gradient);">Aa</div>
            <div class="color-info">
              <code>--accent-gradient</code>
              <span class="color-value">Surface + --accent-ink</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: var(--accent-gradient-display);"></div>
            <div class="color-info">
              <code>--accent-gradient-display</code>
              <span class="color-value">Large text, 24px+</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: var(--accent-gradient-text);"></div>
            <div class="color-info">
              <code>--accent-gradient-text</code>
              <span class="color-value">Small text</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: var(--success-gradient);"></div>
            <div class="color-info">
              <code>--success-gradient</code>
              <span class="color-value">Confirmations</span>
            </div>
          </div>
        </div>

        <h3>Text</h3>
        <div class="color-grid">
          <div class="color-swatch">
            <div class="swatch" style="background: #fafafa;"></div>
            <div class="color-info">
              <span class="color-label">Heading (dark)</span>
              <span class="color-value">#fafafa</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: #111;"></div>
            <div class="color-info">
              <span class="color-label">Heading (light)</span>
              <span class="color-value">#111111</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: #e0e0e0;"></div>
            <div class="color-info">
              <span class="color-label">Body (dark)</span>
              <span class="color-value">#e0e0e0</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: #333;"></div>
            <div class="color-info">
              <span class="color-label">Body (light)</span>
              <span class="color-value">#333333</span>
            </div>
          </div>
        </div>

        <h3>Semantic</h3>
        <p class="section-note">
          Each family is stated at reading strength, because every one of them
          ends up under white text at 10–13px somewhere in the kit. These are
          the inks; the solid badge and toast grounds are a shade deeper again.
        </p>
        <div class="color-grid">
          <div class="color-swatch">
            <div class="swatch" style="background: #00875d;"></div>
            <div class="color-info">
              <span class="color-label">Success</span>
              <span class="color-value">#00875d</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: #955d00;"></div>
            <div class="color-info">
              <span class="color-label">Warning</span>
              <span class="color-value">#955d00</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: #c2141a;"></div>
            <div class="color-info">
              <span class="color-label">Danger</span>
              <span class="color-value">#c2141a</span>
            </div>
          </div>
          <div class="color-swatch">
            <div class="swatch" style="background: #4338ca;"></div>
            <div class="color-info">
              <span class="color-label">Info</span>
              <span class="color-value">#4338ca</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ================================================================
           LIQUID GLASS
           ================================================================ -->
      <section id="liquid-glass">
        <h2>Liquid glass</h2>
        <p>
          Every translucent surface on the site is one of four materials, all
          declared once in <code>global.css</code>. They are not
          interchangeable: each answers a different question about what is
          behind the surface. Reach for a token, never a fresh
          <code>blur()</code> — a second dialect of the same material is how
          this system went wrong the first time.
        </p>

        <h3>The four materials</h3>
        <div class="glass-demo">
          <div class="glass-demo__stage">
            <div class="glass-demo__tile liquid-glass">Chrome</div>
            <div class="glass-demo__tile glass-demo__tile--card">Card</div>
            <div class="glass-demo__tile glass-demo__tile--media">On media</div>
            <div class="glass-demo__scroller">
              <div class="glass-demo__veil">Veil</div>
              <p>Content passes</p>
              <p>under the veil</p>
              <p>and dissolves</p>
              <p>into the page.</p>
              <p>Scroll me.</p>
            </div>
          </div>
        </div>

        <dl class="glass-tokens">
          <dt><code>--glass-*</code> — chrome</dt>
          <dd>
            Floating capsules you look <em>through</em>: the nav dock, the home
            pill, the language switcher, the condensed page title. Light tint
            (0.55), frost, and a refractive rim. Apply with the
            <code>.liquid-glass</code> utility.
          </dd>

          <dt><code>--card-bg</code> — card</dt>
          <dd>
            Content you read, not chrome you look past. Heavier tint (0.7),
            borrows the border, shadow and rim from the chrome tokens, and
            deliberately carries <strong>no frost</strong> — blur earns its keep
            over content, and a card <em>is</em> the content.
          </dd>

          <dt><code>--glass-*-on-media</code> — on media</dt>
          <dd>
            Glass over a photograph, where the backdrop is arbitrary. It cannot
            follow the colour scheme: a light tint would drop dark text onto a
            dark photo. So the tint stays dark in both themes, the label stays
            white, and it is heavy enough to carry the label with the frost
            gone — see the transform trap below.
          </dd>

          <dt><code>--veil-*</code> — veil</dt>
          <dd>
            Not glass at all: the page's own colour closing over what scrolls
            beneath it. Used by the pinned header strip and
            <code>/travel</code>'s sticky year. A capsule is a neutral tint you
            look through; this one belongs to the page. It stays translucent on
            purpose: a page with an ambient background has that behind the veil
            too, and an opaque strip cuts a flat rectangle out of it. The frost
            is what keeps what passes underneath from being readable — which is
            why the blur is heavier here than the number it started at.
          </dd>
        </dl>

        <h3>The utility</h3>
        <p>
          <code>.liquid-glass</code> paints the tint, sheen, frost, border and
          shadow, and adds the rim as an <code>::after</code>. Two things it
          leaves to the consumer: the <strong>border-radius</strong>, which the
          rim inherits, and <strong>position</strong> — the rim needs a
          positioned host, but forcing <code>relative</code> here would fight
          consumers that position themselves.
        </p>

        <h3>The transform trap</h3>
        <p>
          A <code>transform</code> on an <em>ancestor</em> resets the
          backdrop-filter root and silently kills the frost — including the
          identity matrix a finished transform animation leaves behind. Animate
          the glass element itself, never a wrapper around it. This is why the
          header's entrance animation sits on the switcher rather than its
          shell, and why the badge tint is heavy enough to survive a card
          lifting on hover.
        </p>

        <h3>Reduced transparency</h3>
        <p>
          Under <code>prefers-reduced-transparency: reduce</code> every surface
          drops its frost for an opaque fallback. The <strong>tint</strong> is
          handled at the token: <code>--card-bg</code>, <code>--veil-bg</code>
          and <code>--glass-bg-on-media</code> all go solid there, so no
          consumer needs to name a colour twice. <code>.liquid-glass</code>
          handles itself entirely.
        </p>
        <p>
          The <strong>frost</strong> goes the same way:
          <code>--glass-filter</code> and <code>--veil-filter</code> both become
          <code>none</code> here, so anything drawing its blur from a token
          loses it without being asked.
        </p>
        <p>
          The chrome <strong>tint</strong> is the one that doesn't follow.
          <code>--glass-bg</code> stays translucent under this media feature, so
          a chrome surface still names its own opaque colour — which is exactly
          what <code>.liquid-glass</code> does on your behalf if you use the
          utility, and what the reserve button, the random-item die, the
          language switcher and the floating tooltip each do by hand because
          they can't. Reach for the utility and this is already handled; write
          the recipe out and the tint is yours to finish.
        </p>
        <p>
          A blur written as a <em>literal</em> is the other case:
          <code>backdrop-filter: blur(10px)</code> spelled out rather than taken
          from <code>--glass-filter</code>. A token can't reach a value that
          never referred to it, so <code>.priority-badge</code> and the kit
          modal's scrim carry their own <code>backdrop-filter: none</code>. Four
          more surfaces blur with a literal and have
          <strong>no fallback at all</strong> — the admin modal, toast and item
          card, and the blog's back-to-top button. That is a gap, not a rule;
          they are listed here so the next person doesn't have to rediscover
          them. If you find yourself writing a blur radius by hand, that is the
          moment to ask whether the token would do.
        </p>
      </section>

      <!-- ================================================================
           TYPOGRAPHY
           ================================================================ -->
      <section id="typography">
        <h2>Typography</h2>

        <h3>Headings</h3>
        <div class="typography-demo">
          <h1>Heading Level 1</h1>
          <h2>Heading Level 2</h2>
          <h3>Heading Level 3</h3>
          <h4>Heading Level 4</h4>
          <h5>Heading Level 5</h5>
          <h6>Heading Level 6</h6>
        </div>

        <h3>Body Text</h3>
        <p>
          This is a standard paragraph with <strong>strong text</strong> and <em>emphasized text</em>.
          The line height is set to 1.75 for optimal readability. You can also use <code>inline code</code>.
        </p>

        <h3>Lists</h3>
        <div class="columns-2">
          <div>
            <h4>Unordered</h4>
            <ul>
              <li>First item</li>
              <li>Second item</li>
              <li>Third item</li>
            </ul>
          </div>
          <div>
            <h4>Ordered</h4>
            <ol>
              <li>First item</li>
              <li>Second item</li>
              <li>Third item</li>
            </ol>
          </div>
        </div>

        <h3>Blockquote</h3>
        <blockquote>
          <p>This is a blockquote with a left border and subtle background.</p>
        </blockquote>
      </section>

      <!-- ================================================================
           LINKS
           ================================================================ -->
      <section id="links">
        <h2>Links</h2>

        <h3>Default (Accent)</h3>
        <p>Links use accent color: <a href="#">regular link</a>. No visited state by default.</p>

        <h3>Navigation Links</h3>
        <p>Class: <code>.link-nav</code></p>
        <p>
          <a href="#" class="link-nav">Home</a> ·
          <a href="#" class="link-nav">Blog</a> ·
          <a href="#" class="link-nav">About</a>
        </p>

        <h3>Muted Links</h3>
        <p>Class: <code>.link-muted</code></p>
        <p>
          <a href="#" class="link-muted">View source</a> ·
          <a href="#" class="link-muted">Edit on GitHub</a>
        </p>
      </section>

      <!-- ================================================================
           BUTTON
           ================================================================ -->
      <section id="button">
        <h2>Button</h2>
        <p class="component-import">
          <code>import Button from "@components/kit/Button.astro"</code>
        </p>

        <h3>Variants</h3>
        <div class="component-row">
          <Button variant="primary">Primary</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="ghost">Ghost</Button>
          <Button variant="success">Success</Button>
          <Button variant="danger">Danger</Button>
        </div>

        <h3>Sizes</h3>
        <div class="component-row">
          <Button variant="primary" size="xs">XS (28px)</Button>
          <Button variant="primary" size="sm">SM (32px)</Button>
          <Button variant="primary" size="md">MD (38px)</Button>
          <Button variant="primary" size="lg">LG (44px)</Button>
        </div>

        <h3>States</h3>
        <div class="component-row">
          <Button variant="primary" disabled>Disabled</Button>
          <Button variant="primary" loading>Loading</Button>
          <Button variant="ghost" active>Active</Button>
        </div>

        <h3>With Icons</h3>
        <div class="component-row">
          <Button variant="primary" size="sm">
            <Icon name="globe" width={14} height={14} />
            With Icon
          </Button>
          <Button variant="ghost" size="md" icon aria-label="Check">
            <Icon name="check" width={18} height={18} />
          </Button>
        </div>

        <h3>As Link</h3>
        <div class="component-row">
          <Button variant="primary" href="#">Go to Blog</Button>
          <Button variant="secondary" href="#">Wishlist</Button>
        </div>
      </section>

      <!-- ================================================================
           TOGGLE GROUP
           ================================================================ -->
      <section id="toggle-group">
        <h2>ToggleGroup</h2>
        <p class="component-import">
          <code>import ToggleGroup from "@components/kit/ToggleGroup.astro"</code><br />
          <code>import {`{ ToggleGroup }`} from "@components/kit/ToggleGroup"</code> (React)
        </p>

        <h3>Pill Variant</h3>
        <p>For language switchers and compact toggles.</p>
        <div class="component-row" id="toggle-pill-demo">
          <ToggleGroup
            items={[
              { id: "en", label: "ENG" },
              { id: "ru", label: "RUS" },
            ]}
            value="en"
            size="sm"
          />
        </div>

        <h3>Separated Variant</h3>
        <p>
          For filter categories. A ghost row: the items are plain labels with
          nothing behind them, a soft wash appears under the cursor, and only
          the current one wears the accent capsule. Built for rows of eight or
          ten, where giving every item a surface of its own drowns out the
          content being filtered.
        </p>
        <div class="component-row" id="toggle-separated-demo">
          <ToggleGroup
            variant="separated"
            size="sm"
            items={[
              { id: "all", label: "All" },
              { id: "tech", label: "Tech" },
              { id: "home", label: "Home" },
            ]}
            value="all"
          />
        </div>

        <h3>Quiet Tone</h3>
        <p>
          <code>tone="quiet"</code> on the separated variant marks the current
          item with ink and the wash it already answers a cursor with, instead
          of the accent capsule. For a row that shares its space with something
          already louder — /travel's country sort sits in a heading forty pixels
          under the pinned view rail, and at full accent it was the brightest
          thing on the page. Ink rather than a second glass capsule on purpose:
          glass there would read as a smaller copy of the rail and make the two
          compete for the same job.
        </p>
        <div class="component-row" id="toggle-quiet-demo">
          <ToggleGroup
            variant="separated"
            tone="quiet"
            size="sm"
            items={[
              { id: "cities", label: "By cities" },
              { id: "name", label: "A–Z" },
              { id: "first", label: "By first visit" },
            ]}
            value="cities"
          />
        </div>

        <h3>Tabs Variant</h3>
        <p>
          The only variant that is not a set of toggles. It renders a real
          <code>role="tablist"</code> — <code>aria-selected</code> rather than
          <code>aria-pressed</code>, <code>aria-controls</code> pointing at the
          panel, and a roving <code>tabindex</code> so the rail is one stop in
          the tab order with the arrow keys moving inside it. Pass
          <code>controls</code> on each item with the id of its panel; the tab
          takes the id <code>{`${"{controls}"}-tab`}</code>, which is what the
          panel points back at with <code>aria-labelledby</code>.
        </p>
        <p>
          The current tab is a lens — the chrome's glass capsule, sliding behind
          the label on the dock's easing. Same idiom as the magnetic dock and
          the language switcher, with one part swapped: their indicator is an
          accent gradient, which suits a small nav floating in the chrome, while
          a tab rail is pinned over content that is already spending the accent.
          One lens for the whole rail, so it travels and the row reads as one
          instrument.
        </p>
        <p>
          Needs a driver:
          <code>import {`{ initToggleTabs }`} from "@client/toggle-tabs"</code>,
          called with the tablist element and a callback that shows the matching
          panel. It handles the keyboard, the marker and the edge fades; nothing
          happens without it beyond the tab the server rendered.
        </p>
        <div class="component-row component-row--stack" id="toggle-tabs-demo">
          <ToggleGroup
            variant="tabs"
            size="sm"
            scrollable
            items={[
              { id: "timeline", label: "Timeline", count: 47, controls: "kit-tab-timeline" },
              { id: "countries", label: "Countries", count: 32, controls: "kit-tab-countries" },
              { id: "continents", label: "Continents", count: "2/7", controls: "kit-tab-continents" },
              { id: "stats", label: "Stats", controls: "kit-tab-stats" },
            ]}
            value="timeline"
          />
          <div class="kit-tab-panels">
            <div id="kit-tab-timeline" role="tabpanel" aria-labelledby="kit-tab-timeline-tab" tabindex="0">47 trips, newest first.</div>
            <div id="kit-tab-countries" role="tabpanel" aria-labelledby="kit-tab-countries-tab" tabindex="0" hidden>32 countries and the cities in them.</div>
            <div id="kit-tab-continents" role="tabpanel" aria-labelledby="kit-tab-continents-tab" tabindex="0" hidden>2 of 7 continents.</div>
            <div id="kit-tab-stats" role="tabpanel" aria-labelledby="kit-tab-stats-tab" tabindex="0" hidden>No count on this tab — it is not a list of anything.</div>
          </div>
        </div>

        <h3>Counts</h3>
        <p>
          Pass <code>count</code> to an item — a number, or a fraction like
          <code>"2/7"</code> where "of how many" is the point. It says what the
          label cannot: how much is behind the tab, so the row answers whether
          a view is worth opening before it is opened. Language-neutral by
          design; a count that needed translating would be a second label. An
          item may go without one, and the gap says something too.
        </p>

        <h3>With Icons</h3>
        <p>Pass <code>icon</code> to items. Icon size adjusts to toggle size (14px for sm, 16px for md).</p>
        <div class="component-row" id="toggle-icons-demo">
          <ToggleGroup
            variant="separated"
            size="sm"
            items={[
              { id: "timeline", label: "Timeline", icon: "timeline" },
              { id: "countries", label: "Countries", icon: "flag" },
              { id: "checklist", label: "Checklist", icon: "checklist" },
            ]}
            value="timeline"
          />
        </div>
      </section>

      <!-- ================================================================
           SELECT
           ================================================================ -->
      <section id="select">
        <h2>Select</h2>
        <p class="component-import">
          <code>import Select from "@components/kit/Select.astro"</code><br />
          <code>import {`{ Select }`} from "@components/kit/Select"</code> (React)
        </p>

        <h3>Sizes</h3>
        <div class="component-row">
          <Select
            size="sm"
            options={[
              { value: "1", label: "SM (32px)" },
              { value: "2", label: "Option 2" },
            ]}
            value="1"
          />
          <Select
            size="md"
            options={[
              { value: "1", label: "MD (38px)" },
              { value: "2", label: "Option 2" },
            ]}
            value="1"
          />
          <Select
            size="lg"
            options={[
              { value: "1", label: "LG (44px)" },
              { value: "2", label: "Option 2" },
            ]}
            value="1"
          />
        </div>

        <h3>With Placeholder</h3>
        <div class="component-row">
          <Select
            size="md"
            placeholder="Select an option..."
            options={[
              { value: "react", label: "React" },
              { value: "vue", label: "Vue" },
              { value: "astro", label: "Astro" },
            ]}
          />
        </div>
      </section>

      <!-- ================================================================
           INPUT
           ================================================================ -->
      <section id="input">
        <h2>Input</h2>
        <p class="component-import">
          <code>import Input from "@components/kit/Input.astro"</code><br />
          <code>import {`{ Input }`} from "@components/kit/Input"</code> (React)
        </p>

        <h3>Sizes</h3>
        <div class="input-demo-grid">
          <Input size="sm" placeholder="SM (32px)" />
          <Input size="md" placeholder="MD (38px)" />
          <Input size="lg" placeholder="LG (44px)" />
        </div>

        <h3>States</h3>
        <div class="input-demo-grid">
          <Input placeholder="Default" />
          <Input placeholder="Disabled" disabled />
          <Input placeholder="Error state" error />
        </div>

        <h3>Form Group</h3>
        <div class="kit-form-group" style="max-width: 300px;">
          <label class="kit-form-label kit-form-label--required">Email</label>
          <Input type="email" placeholder="you@example.com" />
          <span class="kit-form-hint">We'll never share your email.</span>
        </div>

        <h3>Form Row</h3>
        <div class="kit-form-row" style="max-width: 500px;">
          <div class="kit-form-group">
            <label class="kit-form-label">First Name</label>
            <Input placeholder="John" />
          </div>
          <div class="kit-form-group">
            <label class="kit-form-label">Last Name</label>
            <Input placeholder="Doe" />
          </div>
        </div>

        <h3>Textarea</h3>
        <div style="max-width: 400px;">
          <textarea class="kit-input kit-input--md" placeholder="Enter description..." rows="3"></textarea>
        </div>
      </section>

      <!-- ================================================================
           CHECKBOX
           ================================================================ -->
      <section id="checkbox">
        <h2>Checkbox</h2>
        <p class="component-import">
          <code>import Checkbox from "@components/kit/Checkbox.astro"</code><br />
          <code>import {`{ Checkbox }`} from "@components/kit/Checkbox"</code> (React)
        </p>
        <p>
          The <strong>pill</strong> variant is a ghost-row capsule — for picking
          several tags out of a row, like the wishlist categories.
          The <strong>box</strong> variant is for a single standalone boolean,
          where an unchecked capsule and an absent one would look the same.
        </p>
        <p>
          The box is a socket, and the tick is the fill lying in it. ProgressBar
          states the rule this follows: <code>--glass-rim</code> is a lens edge
          lit from the top left, so a channel sunk into the same surface is its
          inverse. A checkbox has two states and the chrome has exactly those
          two opposite treatments — and both halves here are the progress bar's,
          value for value, because at this size a checkbox is a meter with two
          stops.
        </p>

        <h3>Pill</h3>
        <div class="kit-checkbox-group">
          <Checkbox size="sm" checked>Games</Checkbox>
          <Checkbox size="sm">Books</Checkbox>
          <Checkbox size="sm">Merch</Checkbox>
          <Checkbox size="sm" disabled>Disabled</Checkbox>
        </div>

        <h3>Box</h3>
        <div class="kit-checkbox-group kit-checkbox-group--vertical">
          <Checkbox variant="box" checked>Received</Checkbox>
          <Checkbox variant="box">Reserved</Checkbox>
          <Checkbox variant="box" disabled>Disabled</Checkbox>
        </div>

        <h3>Sizes</h3>
        <div class="kit-checkbox-group">
          <Checkbox size="sm" checked>SM (32px)</Checkbox>
          <Checkbox size="md" checked>MD (38px)</Checkbox>
        </div>
        <div class="kit-checkbox-group">
          <Checkbox variant="box" size="sm" checked>SM</Checkbox>
          <Checkbox variant="box" size="md" checked>MD</Checkbox>
        </div>

        <h3>The mark on its own</h3>
        <p>
          <code>.kit-check</code> is the box without an input around it, for a
          ticked state that is not a control — /travel's checklist marks 250
          countries as seen or not, and none of them is something to click. Add
          <code>.kit-check--on</code> for the ticked state and set
          <code>--kit-check-size</code> for anything other than the kit's own
          two. It exists so that idea has one appearance on the site rather than
          growing a second one in a page's own stylesheet, which is where it had
          got to.
        </p>
        <div class="component-row kit-check-demo">
          <span class="kit-check kit-check--on" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="2.5 6 5 8.5 9.5 3.5" />
            </svg>
          </span>
          <span class="kit-check" aria-hidden="true"></span>
          <span class="kit-check kit-check--on" style="--kit-check-size: 22px" aria-hidden="true">
            <svg viewBox="0 0 12 12" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="2.5 6 5 8.5 9.5 3.5" />
            </svg>
          </span>
          <span class="kit-check" style="--kit-check-size: 22px" aria-hidden="true"></span>
        </div>
      </section>

      <!-- ================================================================
           BADGE
           ================================================================ -->
      <section id="badge">
        <h2>Badge</h2>
        <p class="component-import">
          <code>import Badge from "@components/kit/Badge.astro"</code>
        </p>

        <h3>Subtle Variants</h3>
        <p>Transparent background, colored text. For inline labels.</p>
        <div class="component-row">
          <Badge variant="default">Default</Badge>
          <Badge variant="primary">Primary</Badge>
          <Badge variant="success">Success</Badge>
          <Badge variant="warning">Warning</Badge>
          <Badge variant="danger">Danger</Badge>
          <Badge variant="info">Info</Badge>
        </div>

        <h3>Solid Variants</h3>
        <p>Gradient background, white text. For status overlays.</p>
        <div class="component-row">
          <Badge variant="solid-success">Received</Badge>
          <Badge variant="solid-primary">Reserved</Badge>
          <Badge variant="solid-info">Info</Badge>
          <Badge variant="solid-warning">Warning</Badge>
          <Badge variant="solid-danger">Error</Badge>
        </div>

        <h3>Glass Variant</h3>
        <p>
          For badges that sit on top of an image, where a solid gradient chip
          becomes a second subject competing with the photo. The capsule is the
          chrome's glass; the state travels on a coloured dot instead of
          flooding the whole badge. Add <code>dot</code> plus a tone class —
          <code>kit-badge--dot-success</code> or
          <code>kit-badge--dot-accent</code>. The tint is dark in both themes,
          because the backdrop is a photograph rather than the page.
        </p>
        <div class="component-row badge-on-photo">
          <Badge variant="glass" dot class="kit-badge--dot-success">
            Received
          </Badge>
          <Badge variant="glass" dot class="kit-badge--dot-accent">
            Reserved
          </Badge>
          <Badge variant="glass">No dot</Badge>
        </div>

        <h3>Sizes</h3>
        <div class="component-row">
          <Badge variant="solid-success" size="sm">Small</Badge>
          <Badge variant="solid-success" size="md">Medium</Badge>
        </div>

        <h3>With Icon</h3>
        <div class="component-row">
          <Badge variant="solid-success">
            <Icon name="check" width={12} height={12} />
            Received
          </Badge>
          <Badge variant="solid-primary">
            <Icon name="check" width={12} height={12} />
            Reserved
          </Badge>
        </div>

        <h3>With Dot</h3>
        <div class="component-row">
          <Badge variant="success" dot>Online</Badge>
          <Badge variant="danger" dot>Offline</Badge>
        </div>
      </section>

      <!-- ================================================================
           PROGRESS BAR
           ================================================================ -->
      <section id="progress-bar">
        <h2>ProgressBar</h2>
        <p class="component-import">
          <code>import ProgressBar from "@components/kit/ProgressBar.astro"</code>
        </p>

        <h3>Basic</h3>
        <div class="progress-demo">
          <ProgressBar value={25} max={100} label="25% complete" />
          <ProgressBar value={50} max={100} label="50% complete" />
          <ProgressBar value={75} max={100} label="75% complete" />
          <ProgressBar value={100} max={100} label="100% complete" />
        </div>

        <h3>Accent Variant</h3>
        <p>
          Use the <code>accent</code> prop for the gradient fill and its glow.
          The track is a groove sunk into whatever surface it sits on — the
          inverse of the lens edge every glass capsule wears — so the bar reads
          as carved rather than drawn on.
        </p>
        <div class="progress-demo">
          <ProgressBar value={42} max={195} label="Countries visited" accent />
        </div>

        <h3>Without Percent</h3>
        <div class="progress-demo">
          <ProgressBar value={3} max={10} label="Steps completed" showPercent={false} />
        </div>

        <h3>Custom Values</h3>
        <p>
          Pass <code>value</code> and <code>max</code> — percent is calculated
          automatically. A <code>max</code> of <code>0</code> reads as 0% rather
          than as the <code>NaN</code> the division would otherwise put in
          <code>aria-valuenow</code> and in the fill's width; a bar with nothing
          to measure against is usually better left unrendered, but it will not
          break the page.
        </p>
        <div class="progress-demo">
          <ProgressBar value={42} max={195} label="42 of 195 countries" />
          <ProgressBar value={5} max={7} label="5 of 7 continents" />
          <ProgressBar value={0} max={0} label="Nothing to measure" />
        </div>

        <h3>Extra Attributes</h3>
        <p>
          A <code>data-*</code> attribute, or an <code>aria-label</code> of your
          own, lands on the inner element — the one carrying
          <code>role="progressbar"</code> — rather than on the row, so it
          reaches the thing a screen reader actually announces. That is how a
          bilingual page translates the label: <code>label</code> renders the
          bar's <code>aria-label</code>, and <code>data-aria-label-en</code> /
          <code>data-aria-label-ru</code> let <code>LangInit</code> swap it on
          load. Without them the label stays in whichever language it was
          written in, whatever the rest of the page is reading as. Nothing else
          gets through, so a misspelled prop is a type error here rather than a
          stray attribute in the HTML and a default silently left in place.
        </p>
        <div class="progress-demo">
          <ProgressBar
            value={23}
            max={44}
            label="Europe: 23 of 44 countries visited"
            data-aria-label-en="Europe: 23 of 44 countries visited"
            data-aria-label-ru="Европа: посещено 23 из 44 стран"
            accent
          />
        </div>
      </section>

      <!-- ================================================================
           MODAL
           ================================================================ -->
      <section id="modal">
        <h2>Modal</h2>
        <p class="component-import">
          CSS: <code>@import "@styles/kit/modal.css"</code>
        </p>

        <h3>Demo</h3>
        <div class="component-row">
          <Button variant="primary" id="open-modal-btn">Open Modal</Button>
        </div>

        <h3>Structure</h3>
        <pre><code>{`<div class="kit-modal-overlay is-open">
  <div class="kit-modal">
    <div class="kit-modal-header">
      <h2 class="kit-modal-title">Title</h2>
      <button class="kit-modal-close">&times;</button>
    </div>
    <div class="kit-modal-body">
      Content here...
    </div>
    <div class="kit-modal-footer">
      <Button variant="secondary">Cancel</Button>
      <Button variant="primary">Save</Button>
    </div>
  </div>
</div>`}</code></pre>

        <h3>Sizes</h3>
        <p>Add class: <code>.kit-modal--sm</code>, <code>.kit-modal--lg</code>, or <code>.kit-modal--full</code></p>
      </section>

      <!-- Modal Demo -->
      <div class="kit-modal-overlay" id="demo-modal">
        <div class="kit-modal">
          <div class="kit-modal-header">
            <h2 class="kit-modal-title">Modal Title</h2>
            <button class="kit-modal-close" id="close-modal-btn">&times;</button>
          </div>
          <div class="kit-modal-body">
            <p>This is an example modal. You can put any content here.</p>
            <div class="kit-form-group">
              <label class="kit-form-label">Example Input</label>
              <Input placeholder="Type something..." />
            </div>
          </div>
          <div class="kit-modal-footer">
            <Button variant="secondary" class="close-modal-btn">Cancel</Button>
            <Button variant="primary" class="close-modal-btn">Save</Button>
          </div>
        </div>
      </div>

      <!-- ================================================================
           TOAST
           ================================================================ -->
      <section id="toast">
        <h2>Toast</h2>
        <p class="component-import">
          CSS: <code>@import "@styles/kit/toast.css"</code>
        </p>

        <h3>Demo</h3>
        <div class="component-row">
          <Button variant="success" size="sm" class="toast-trigger" data-variant="success">Success</Button>
          <Button variant="danger" size="sm" class="toast-trigger" data-variant="error">Error</Button>
          <Button variant="secondary" size="sm" class="toast-trigger" data-variant="warning">Warning</Button>
          <Button variant="ghost" size="sm" class="toast-trigger" data-variant="info">Info</Button>
        </div>

        <h3>Positions</h3>
        <p>Default is bottom-center. Add position class to container.</p>
        <div class="component-row">
          <Select
            size="sm"
            id="toast-position-select"
            options={[
              { value: "", label: "bottom-center (default)" },
              { value: "kit-toast-container--top-center", label: "top-center" },
              { value: "kit-toast-container--top-right", label: "top-right" },
              { value: "kit-toast-container--top-left", label: "top-left" },
              { value: "kit-toast-container--bottom-right", label: "bottom-right" },
              { value: "kit-toast-container--bottom-left", label: "bottom-left" },
            ]}
            value=""
          />
        </div>

        <h3>Structure</h3>
        <pre><code>{`<div class="kit-toast-container">
  <div class="kit-toast kit-toast--success">
    <span class="kit-toast-icon">✓</span>
    <div class="kit-toast-content">
      <p class="kit-toast-title">Success</p>
      <p class="kit-toast-message">Item saved.</p>
    </div>
    <button class="kit-toast-dismiss">&times;</button>
  </div>
</div>`}</code></pre>

        <h3>Type Variants</h3>
        <p><code>.kit-toast--success</code>, <code>.kit-toast--error</code>, <code>.kit-toast--warning</code>, <code>.kit-toast--info</code></p>

        <h3>Position Variants</h3>
        <p><code>.kit-toast-container--top-center</code>, <code>.kit-toast-container--top-right</code>, <code>.kit-toast-container--top-left</code>, <code>.kit-toast-container--bottom-right</code>, <code>.kit-toast-container--bottom-left</code></p>
      </section>

      <!-- Toast Container -->
      <div class="kit-toast-container" id="toast-container"></div>

      <!-- ================================================================
           TOOLTIPS
           ================================================================ -->
      <section id="tooltips">
        <h2>Tooltips</h2>

        <h3>Usage</h3>
        <p>
          Add a <code>data-tooltip</code> attribute to any element. The tooltip
          is a liquid-glass bead that trails the cursor while it's over the
          trigger; on keyboard focus, where there is no cursor, it pins itself
          above the element instead.
        </p>

        <div class="component-row">
          <Button variant="secondary" data-tooltip="This is a tooltip">
            Hover me
          </Button>
          <span class="tooltip-demo" data-tooltip="Tooltips work on any element">
            Any element
          </span>
        </div>
      </section>

    </main>
  </div>
</PageLayout>

<style is:global>
  /* Layout */
  /* Both of these carried !important, and neither had anything to beat —
     nothing outside this file mentions .kit-layout. What they did beat was the
     media query at the bottom of this stylesheet, which asks for a column
     under 768px and was being ignored: the sidebar stayed alongside the
     content and the page ran 511px past the right edge of a phone. */
  .kit-layout {
    display: flex;
    flex-direction: row;
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
  }

  /* Sidebar */
  .kit-sidebar {
    position: sticky;
    top: 0;
    width: 200px;
    height: 100vh;
    padding: 2rem 1rem 2rem 1.5rem;
    border-right: 1px solid light-dark(#eee, #333);
    overflow-y: auto;
    flex-shrink: 0;
  }

  .kit-nav-section {
    margin-bottom: 1.5rem;
  }

  .kit-nav-section h3 {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    margin: 0 0 0.5rem 0;
  }

  .kit-nav-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .kit-nav-section li {
    margin: 0;
  }

  .kit-nav-section a {
    display: block;
    padding: 0.35rem 0;
    font-size: 0.85rem;
    color: light-dark(#555, #aaa);
    text-decoration: none;
    transition: color 0.15s;
  }

  .kit-nav-section a:hover {
    color: var(--accent-start);
  }

  /* Content */
  .kit-content {
    flex: 1;
    padding: 2rem 2.5rem;
    max-width: 800px;
  }

  .kit-content h1 {
    margin-bottom: 0.5rem;
  }

  .kit-intro {
    color: light-dark(#666, #aaa);
    margin-bottom: 3rem;
  }

  .kit-content section {
    margin-bottom: 4rem;
  }

  .kit-content h2 {
    padding-top: 1rem;
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid light-dark(#eee, #333);
  }

  .kit-content h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .component-import {
    margin-bottom: 1.5rem;
  }

  .component-import code {
    font-size: 0.8rem;
  }

  /* The one swatch that has to prove something rather than just show a colour:
     the accent carries a label, so it shows the label. */
  .swatch--ink {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent-ink);
  }

  /* A line of prose under a heading, before its grid — for the places where
     which token to reach for is the thing worth documenting. */
  .section-note {
    max-width: 62ch;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* Color swatches */
  .color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .color-swatch {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .swatch {
    height: 50px;
    border-radius: 8px;
    border: 1px solid light-dark(#e0e0e0, #333);
  }

  .color-info {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .color-info code {
    font-size: 0.7rem;
  }

  .color-label {
    font-size: 0.7rem;
    font-weight: 500;
    color: light-dark(#333, #e0e0e0);
  }

  .color-value {
    font-size: 0.65rem;
    font-family: var(--font-fira-code);
    color: var(--ink-muted);
  }

  /* Liquid glass demo — the four materials over one busy backdrop, because
     glass only shows what it is when there is something behind it to disturb.
     The stage carries the pattern; each tile is the real material, taking the
     same tokens the site uses, so this page can never drift from it. */
  .glass-demo {
    margin-bottom: 1.5rem;
  }

  .glass-demo__stage {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 16px;
    background-color: light-dark(#e8e6ff, #241f2e);
    background-image:
      radial-gradient(
        circle at 18% 30%,
        var(--accent-start) 0,
        transparent 42%
      ),
      radial-gradient(circle at 78% 70%, #4fc3f7 0, transparent 45%),
      repeating-linear-gradient(
        45deg,
        light-dark(rgba(0, 0, 0, 0.06), rgba(255, 255, 255, 0.06)) 0 8px,
        transparent 8px 16px
      );
  }

  .glass-demo__tile {
    position: relative; /* hosts the .liquid-glass rim */
    display: inline-flex;
    align-items: center;
    padding: 0 1.1rem;
    min-height: 3rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: light-dark(#333, #fafafa);
  }

  /* Card: the chrome's edge and shadow, its own heavier tint, and no frost. */
  .glass-demo__tile--card {
    background: var(--card-bg);
    border: var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: 14px;
  }

  .glass-demo__tile--card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: var(--glass-rim);
  }

  /* On media: the one material that ignores the colour scheme. */
  .glass-demo__tile--media {
    background-color: var(--glass-bg-on-media);
    backdrop-filter: var(--glass-filter);
    border: var(--glass-border-on-media);
    color: #fff;
  }

  .glass-demo__tile--media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: var(--glass-rim-on-media);
  }

  /* Veil: needs something to scroll under it, so it gets a box of its own. */
  .glass-demo__scroller {
    flex: 1 1 12rem;
    min-width: 10rem;
    height: 8rem;
    overflow-y: auto;
    border-radius: 14px;
    background: light-dark(var(--light-bg), var(--dark-bg));
    padding: 0 0.9rem 0.9rem;
  }

  .glass-demo__scroller p {
    margin: 0.4rem 0;
    font-size: 0.8rem;
    color: light-dark(#555, #b4b4b8);
  }

  .glass-demo__veil {
    position: sticky;
    top: 0;
    /* Spans the scroller's own padding, or content would slide past it up the
       left and right edges — with a veil that is the whole thing being shown. */
    margin-inline: -0.9rem;
    padding: 0.5rem 0.9rem;
    background-color: var(--veil-bg);
    backdrop-filter: var(--veil-filter);
    border-bottom: var(--glass-border);
    font-size: 0.85rem;
    font-weight: 600;
    color: light-dark(#333, #fafafa);
  }

  .glass-tokens {
    margin: 0 0 1.5rem;
  }

  .glass-tokens dt {
    margin-top: 1rem;
    font-weight: 600;
    color: light-dark(#111, #fafafa);
  }

  .glass-tokens dd {
    margin: 0.35rem 0 0;
    color: light-dark(#333, #e0e0e0);
  }

  /* Typography demo */
  .typography-demo {
    padding: 1.5rem;
    background: light-dark(rgba(0, 0, 0, 0.02), rgba(255, 255, 255, 0.02));
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  .typography-demo h1,
  .typography-demo h2,
  .typography-demo h3,
  .typography-demo h4,
  .typography-demo h5,
  .typography-demo h6 {
    margin: 0.5rem 0;
  }

  .columns-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  /* Components */
  .component-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  /* A tab rail is only half a control without the thing it swaps, so its demo
     stacks the rail over its panels rather than laying them out side by side. */
  .component-row--stack {
    display: block;
  }

  .kit-tab-panels {
    padding: 0.9rem 0.1rem;
    font-size: 0.9rem;
    color: light-dark(#555, #b4b4b8);
  }

  /* Glass badges are meant to be read against a photo, so the demo gives them
     something to sit on — a flat swatch would flatter them unfairly. */
  .badge-on-photo {
    padding: 1.25rem;
    border-radius: 16px;
    background:
      radial-gradient(circle at 20% 30%, #f0a05a, transparent 55%),
      radial-gradient(circle at 75% 65%, #5a7cf0, transparent 60%),
      linear-gradient(135deg, #8a7f6d, #3a3f4a);
  }

  .input-demo-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 300px;
    margin-bottom: 1.5rem;
  }

  .progress-demo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 400px;
    margin-bottom: 1.5rem;
  }

  /* Tooltip demo */
  .tooltip-demo {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: light-dark(rgba(0, 0, 0, 0.05), rgba(255, 255, 255, 0.1));
    border-radius: 8px;
    font-size: 0.85rem;
    color: light-dark(#333, #ccc);
    cursor: default;
  }

  /* Code blocks */
  .kit-content pre {
    margin: 1rem 0 1.5rem;
    padding: 1rem;
    background: light-dark(#1e1e1e, #0d0d0d);
    border-radius: 8px;
    overflow-x: auto;
  }

  .kit-content pre code {
    font-size: 0.8rem;
    line-height: 1.5;
    color: light-dark(#d4d4d4, #d4d4d4);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .kit-layout {
      flex-direction: column;
    }

    .kit-sidebar {
      position: relative;
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid light-dark(#eee, #333);
      padding: 1.5rem 1rem;
      /* There is no global box-sizing reset on this site, so 100% plus 1rem of
         padding on each side is 100% plus 32px — which is exactly how far the
         page ran past the right edge of a phone once the sidebar was allowed
         to stack. */
      box-sizing: border-box;
    }

    .kit-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .kit-nav-section {
      margin-bottom: 0;
    }

    .kit-content {
      padding: 1.5rem 1rem;
    }

    .columns-2 {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  // Tooltips — the demo below is inert without this.
  import { initTooltips } from '@client/tooltip';
  import { initToggleTabs } from '@client/toggle-tabs';
  initTooltips();

  // Modal demo
  const openModalBtn = document.getElementById('open-modal-btn');
  const closeModalBtns = document.querySelectorAll('.close-modal-btn, #close-modal-btn');
  const modal = document.getElementById('demo-modal');

  openModalBtn?.addEventListener('click', () => {
    modal?.classList.add('is-open');
  });

  closeModalBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modal?.classList.remove('is-open');
    });
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.remove('is-open');
    }
  });

  // ToggleGroup demo
  function initToggleGroup(containerId: string) {
    const container = document.getElementById(containerId);
    const buttons = container?.querySelectorAll('.kit-toggle-item');

    buttons?.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();

        // Update active state
        buttons.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
      });
    });
  }

  initToggleGroup('toggle-pill-demo');
  initToggleGroup('toggle-separated-demo');
  initToggleGroup('toggle-quiet-demo');
  initToggleGroup('toggle-icons-demo');

  // The tabs variant has a real driver rather than a demo one — it is the same
  // module /travel calls, so what is on show here is what a caller gets.
  const tabsDemo = document.querySelector<HTMLElement>('#toggle-tabs-demo [role="tablist"]');
  if (tabsDemo) {
    const panels = document.querySelectorAll<HTMLElement>('.kit-tab-panels > [role="tabpanel"]');
    initToggleTabs(tabsDemo, (id) => {
      panels.forEach((panel) => {
        panel.toggleAttribute('hidden', panel.id !== `kit-tab-${id}`);
      });
    });
  }

  // Toast demo
  const toastContainer = document.getElementById('toast-container');
  const toastTriggers = document.querySelectorAll('.toast-trigger');
  const positionSelect = document.getElementById('toast-position-select') as HTMLSelectElement;

  const toastMessages = {
    success: { title: 'Success', message: 'Action completed successfully.' },
    error: { title: 'Error', message: 'Something went wrong.' },
    warning: { title: 'Warning', message: 'Please review your input.' },
    info: { title: 'Info', message: 'Here is some information.' },
  };

  const toastIcons = {
    success: '✓',
    error: '✕',
    warning: '!',
    info: 'i',
  };

  // Position change handler
  positionSelect?.addEventListener('change', () => {
    if (!toastContainer) return;
    // Remove all position classes
    toastContainer.className = 'kit-toast-container';
    // Add selected position class
    if (positionSelect.value) {
      toastContainer.classList.add(positionSelect.value);
    }
  });

  toastTriggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const variant = (trigger as HTMLElement).dataset.variant as keyof typeof toastMessages;
      const { title, message } = toastMessages[variant];
      const icon = toastIcons[variant];

      const toast = document.createElement('div');
      toast.className = `kit-toast kit-toast--${variant}`;
      toast.innerHTML = `
        <span class="kit-toast-icon">${icon}</span>
        <div class="kit-toast-content">
          <p class="kit-toast-title">${title}</p>
          <p class="kit-toast-message">${message}</p>
        </div>
        <button class="kit-toast-dismiss">&times;</button>
      `;

      toastContainer?.appendChild(toast);

      const dismiss = toast.querySelector('.kit-toast-dismiss');
      const removeToast = () => {
        toast.classList.add('is-leaving');
        setTimeout(() => toast.remove(), 200);
      };

      dismiss?.addEventListener('click', removeToast);
      setTimeout(removeToast, 4000);
    });
  });
</script>
