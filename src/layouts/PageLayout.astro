---
import "@styles/global.css";
import { Font } from "astro:assets";
import { SEO } from "astro-seo";

interface AlternateLink {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: "en" | "ru";
  alternates?: AlternateLink[];
}

const {
  title,
  description = "Software engineer & traveler",
  image,
  lang = "en",
  alternates = [],
} = Astro.props;
const cdnDomain = import.meta.env.PROD ? "cdn.orlovsky.dev" : null;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? "https://orlovsky.dev/og-image.png";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImage,
          url: canonicalURL.href,
        },
        optional: {
          description,
          siteName: "Zach",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: ogImage,
      }}
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#000000" />
    <meta
      name="theme-color"
      content="#f8f8ff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#191919"
      media="(prefers-color-scheme: dark)"
    />
    {cdnDomain && <link rel="preconnect" href={`https://${cdnDomain}`} />}
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-fira-code" />
    <slot name="head" />
  </head>
  <body>
    {/* Every page on this site puts its content in <main id="main">, which is
        what makes one link here enough. It matters most on /travel, where the
        repeated block a keyboard user would otherwise walk through is a map:
        MapLibre gives its canvas a tabindex, so reaching the trip list below
        means passing through a control that answers arrow keys by panning.

        Visible only when focused, and it is the first thing in the tab order,
        so the first Tab on any page offers the way past. It is deliberately
        not translated at runtime like the rest of the chrome: the swap happens
        in a script after paint, and this link has to be usable by someone who
        pressed Tab before that ran. It carries the language the document was
        served in, which is what <html lang> already claims. */}
    <a class="skip-link" href="#main">
      {lang === "ru" ? "Перейти к содержимому" : "Skip to content"}
    </a>
    <slot />
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "3af10005546641a0882b81846b2f6d3b"}'></script>
  </body>
</html>
