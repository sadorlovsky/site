---
import "@styles/global.css";
import { Font } from "astro:assets";
import { SEO } from "astro-seo";

interface AlternateLink {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: "en" | "ru";
  alternates?: AlternateLink[];
}

const {
  title,
  description = "Software engineer & traveler",
  image,
  lang = "en",
  alternates = [],
} = Astro.props;
const cdnDomain = import.meta.env.PROD ? "cdn.orlovsky.dev" : null;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ?? "https://orlovsky.dev/og-image.png";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      openGraph={{
        basic: {
          title,
          type: "website",
          image: ogImage,
          url: canonicalURL.href,
        },
        optional: {
          description,
          siteName: "Zach",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title,
        description,
        image: ogImage,
      }}
    />
    <link rel="icon" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#000000" />
    <meta
      name="theme-color"
      content="#f8f8ff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#191919"
      media="(prefers-color-scheme: dark)"
    />
    {cdnDomain && <link rel="preconnect" href={`https://${cdnDomain}`} />}
    <Font cssVariable="--font-inter" preload />
    {/* Neither of these is preloaded: the page's first paint is upright Latin
        text, and both of these are for something further down it — a code
        block, a quote, an emphasised word. The @font-face lands in the head
        either way, so the file is on its way as soon as any text matches it. */}
    <Font cssVariable="--font-inter-italic" />
    <Font cssVariable="--font-fira-code" />
    <slot name="head" />
  </head>
  <body>
    {/* Every page on this site puts its content in <main id="main">, which is
        what makes one link here enough. It matters most on /travel, where the
        repeated block a keyboard user would otherwise walk through is a map:
        MapLibre gives its canvas a tabindex, so reaching the trip list below
        means passing through a control that answers arrow keys by panning.

        Visible only when focused, and it is the first thing in the tab order,
        so the first Tab on any page offers the way past.

        Both languages ship in the markup and CSS picks one, rather than a
        script swapping the text after paint — this link has to be usable by
        someone who pressed Tab before any script ran. `:lang(ru)` is what
        chooses, and it is the only selector that answers for both kinds of
        page this site has: a post is *served* as `<html lang="ru">`, and every
        client-switched page has LangInit set `documentElement.lang`
        synchronously, before the first paint.

        It used to render one string from the `lang` prop, and only a post ever
        passes one. So /wishlist, /travel and /blog — the pages that actually
        change language in the browser, and where about half the readers read
        Russian — served "Skip to content" to everybody, permanently. The
        hidden half is `display: none`, so this is still one tab stop. */}
    <a class="skip-link" href="#main">
      <span class="skip-link__en">Skip to content</span>
      <span class="skip-link__ru">Перейти к содержимому</span>
    </a>
    <slot />
  </body>
</html>
