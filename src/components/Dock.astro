---
// Magnetic glass dock — shared navigation used on the home page and in PageHeader.
// Markup + styles live here; the magnetic/indicator behaviour is in @client/nav-dock.ts.
interface DockItem {
  href: string;
  en: string;
  ru: string;
}

interface Props {
  items: DockItem[];
  /** Current pathname; the matching item gets the resting indicator. */
  activeHref?: string;
  /** Initial render language (client swaps via data-en/data-ru). */
  lang?: "en" | "ru";
  /** Drop the glass shell — for embedding inside another glass surface. */
  bare?: boolean;
  class?: string;
}

const {
  items,
  activeHref,
  lang = "en",
  bare = false,
  class: className,
} = Astro.props;

function isActive(href: string): boolean {
  if (!activeHref) return false;
  return activeHref === href || activeHref.startsWith(`${href}/`);
}
---

<nav
  class:list={["dock", { "dock--bare": bare, "liquid-glass": !bare }, className]}
  data-dock
  aria-label="Site"
>
  <span class="dock-indicator" aria-hidden="true"></span>
  {
    items.map((item) => (
      <a
        class:list={["dock-item", { "is-active": isActive(item.href) }]}
        href={item.href}
        data-en={item.en}
        data-ru={item.ru}
        aria-current={isActive(item.href) ? "page" : undefined}
      >
        {lang === "ru" ? item.ru : item.en}
      </a>
    ))
  }
</nav>

<style>
  /* The glass shell comes from the shared .liquid-glass utility (global.css),
     added only when the dock isn't embedded (`bare`). */
  .dock {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem;
    border-radius: 999px;
  }

  /* Embedded variant: no glass shell of its own (the parent provides it). */
  .dock--bare {
    padding: 0;
    border-radius: 0;
  }

  .dock-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--dock-w, 0);
    height: var(--dock-h, 0);
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    box-shadow: 0 4px 16px rgba(237, 87, 96, 0.45);
    opacity: 0;
    transform: translate(var(--dock-x, 0), var(--dock-y, 0)) scale(0.9);
    transition:
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
    pointer-events: none;
    z-index: 0;
  }

  .dock[data-active] .dock-indicator {
    opacity: 1;
    transform: translate(var(--dock-x, 0), var(--dock-y, 0)) scale(1);
  }

  .dock-item {
    position: relative;
    z-index: 1;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    color: light-dark(#555, #b4b4b8);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.3s ease;
    will-change: transform;
  }

  .dock-item:hover {
    color: light-dark(#1a1a1a, #fff);
  }

  .dock-item.is-active {
    color: #fff;
  }

  .dock-item:focus-visible {
    outline: 2px solid light-dark(#333, #fff);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .dock:not(.dock--bare) {
      gap: 0.15rem;
      padding: 0.35rem;
    }

    .dock-item {
      padding: 0.45rem 0.85rem;
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-indicator,
    .dock-item {
      transition: none;
    }
  }
</style>

<script src="@client/nav-dock.ts"></script>
