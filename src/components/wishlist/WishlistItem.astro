---
import { Icon } from "astro-icon/components";
import { derivativeKey, derivativeSrcSet } from "@lib/images";
import Badge from "@components/kit/Badge.astro";
import {
  formatHostLabel,
  getCdnImageUrl,
  type WishlistItemWithReservation,
} from "@lib/wishlist";

interface Props {
  item: WishlistItemWithReservation;
  isLCP?: boolean;
  /** Above-the-fold items load eagerly instead of waiting for lazy IO */
  eager?: boolean;
  reservationsEnabled?: boolean;
}

const {
  item,
  isLCP = false,
  eager = false,
  reservationsEnabled = true,
} = Astro.props;
// Every URL here is a file that already exists on the CDN, written when the
// picture was uploaded — no <Image>, no getImage, nothing that could route a
// photograph back through this site's own function. lib/images.ts holds the
// naming scheme and the reasoning; the short version is that the widths are
// part of the key, so the srcset is built by string and needs to ask nobody
// what has been made.
//
// The item's `imageUrl` is the original, and nothing on the page points at it:
// it is the negative, kept to re-derive from.
const lightSrcSet = derivativeSrcSet(item.imageUrl, getCdnImageUrl);
// The `src` is the fallback for anything that ignores srcset, and 560 is the
// width the card is drawn at.
const lightSrc = getCdnImageUrl(derivativeKey(item.imageUrl, 560));

// A dark-theme render, where there is one, is a media-gated <source> — art
// direction, which is a different picture rather than the same one resized.
const darkSrcSet = item.imageUrlDark
  ? derivativeSrcSet(item.imageUrlDark, getCdnImageUrl)
  : null;

const imageSizes =
  "(max-width: 768px) calc(100vw - 2rem), (max-width: 935px) 45vw, 380px";

// Where to buy this. One shop or five, it is the same list rendered the same
// way — a lone shop link is a one-row list, not a different piece of markup,
// which is what keeps the two visually identical.
//
// Each row names its option: the owner's label where there is one, the shop's
// hostname otherwise. Per-row prices only appear when there is a choice to
// make; with one row the price belongs in the footer and nowhere else.
const showOptionPrices = item.options.length > 1;

const options = item.options
  .map((option) => {
    const host = option.url ? formatHostLabel(option.url) : "";
    return {
      ...option,
      labelEn: option.label || host,
      labelRu: option.labelRu || option.label || host,
      // `!== null`: null is "no price we can read", 0 is a price that rounds to
      // nothing, and only the first of those should leave the label off.
      priceUsdLabel:
        option.priceUsd !== null
          ? `$${(option.priceUsd / 100).toFixed(0)}`
          : null,
      priceRubLabel:
        option.priceRub !== null
          ? `₽${(option.priceRub / 100).toFixed(0)}`
          : null,
    };
  })
  // A row with no label and no price of its own would be an empty line: that
  // is the sole option of an item nobody gave a link to, and its price is
  // already in the footer.
  .filter((option) => option.labelEn || showOptionPrices);

---

<article
  class={`wishlist-item ${item.received ? "item-received" : ""}`}
  data-item-id={item.id}
  data-category={item.category}
  aria-label={item.title}
  data-aria-label-en={item.title}
  data-aria-label-ru={item.titleRu || item.title}
>
  <div class="item-image">
    <div class="skeleton"></div>
    <picture>
      {darkSrcSet && (
        <source
          media="(prefers-color-scheme: dark)"
          type="image/webp"
          srcset={darkSrcSet}
          sizes={imageSizes}
        />
      )}
      <img
        class="wishlist-img"
        src={lightSrc}
        srcset={lightSrcSet}
        sizes={imageSizes}
        alt={item.title}
        width={560}
        height={420}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={isLCP ? "high" : undefined}
      />
    </picture>
    {
      item.received && (
        <Badge
          variant="glass"
          dot
          class="wishlist-badge kit-badge--dot-success"
        >
          <span class="badge-label" data-en="Received" data-ru="Получено">
            Received
          </span>
        </Badge>
      )
    }
    <Badge
      variant="glass"
      dot
      class="wishlist-badge own-reservation-badge kit-badge--dot-success"
      hidden
    >
      <span
        class="badge-label"
        data-en="Reserved by you"
        data-ru="Вы зарезервировали"
      >
        Reserved by you
      </span>
    </Badge>
    <Badge
      variant="glass"
      dot
      class="wishlist-badge reserved-badge kit-badge--dot-accent"
      hidden={!item.isReserved}
    >
      <span class="badge-label" data-en="Reserved" data-ru="Зарезервировано">
        Reserved
      </span>
    </Badge>
  </div>
  <div class="item-content">
    <h2
      class="item-title"
      data-en={item.title}
      data-ru={item.titleRu || item.title}
    >
      {item.title}
    </h2>
    {
      options.length > 0 && (
        <ul class="item-options">
          {options.map((option) => (
            <li class="item-option">
              {/* The translations go on the inner label, never on the link
                  itself: LangInit rewrites a data-en element's textContent
                  wholesale, which would take the icon with it. */}
              {option.url && option.labelEn && (
                <a
                  href={option.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="item-url"
                  aria-label={`Open ${option.labelEn} for ${item.title} (opens in new tab)`}
                  data-aria-label-en={`Open ${option.labelEn} for ${item.title} (opens in new tab)`}
                  data-aria-label-ru={`Открыть ${option.labelRu} для ${item.titleRu || item.title} (откроется в новой вкладке)`}
                >
                  <span
                    class="item-url__label"
                    data-en={option.labelEn}
                    data-ru={option.labelRu}
                  >
                    {option.labelEn}
                  </span>
                  <Icon
                    class="item-url__icon"
                    name="arrow-up-right"
                    width={12}
                    height={12}
                    aria-hidden="true"
                  />
                </a>
              )}
              {/* No link, so no icon — this option is a shop you walk into */}
              {!option.url && option.labelEn && (
                <span class="item-url">
                  <span
                    class="item-url__label"
                    data-en={option.labelEn}
                    data-ru={option.labelRu}
                  >
                    {option.labelEn}
                  </span>
                </span>
              )}
              {showOptionPrices && (
                <span
                  class="item-option-price"
                  data-price-original={option.price}
                  data-price-usd={option.priceUsdLabel}
                  data-price-rub={option.priceRubLabel}
                  data-original-is-usd={
                    option.price.startsWith("$") ? "true" : null
                  }
                >
                  {option.price}
                </span>
              )}
            </li>
          ))}
        </ul>
      )
    }
    {
      (item.description || item.descriptionRu) && (
        <p
          class="item-description"
          data-en={item.description || ""}
          data-ru={item.descriptionRu || item.description || ""}
        >
          {item.description}
        </p>
      )
    }
    <div class="item-footer">
      {/* With options on the card this is the cheapest of them, so it says
          "from" — the price above is a floor, not the price. */}
      <span
        class="item-price"
        data-price-original={item.price}
        data-price-usd={item.priceUsd !== null
          ? `$${(item.priceUsd / 100).toFixed(0)}`
          : null}
        data-price-rub={item.priceRub !== null
          ? `₽${(item.priceRub / 100).toFixed(0)}`
          : null}
        data-original-is-usd={item.price.startsWith("$") ? "true" : null}
        data-price-prefix-en={showOptionPrices ? "from" : null}
        data-price-prefix-ru={showOptionPrices ? "от" : null}
      >
        {showOptionPrices ? `from ${item.price}` : item.price}
      </span>

      {
        !item.received && reservationsEnabled && (
          <div class="reserve-actions">
            <button
              class="message-btn"
              data-item-id={item.id}
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="reservation-message"
              aria-label={`Leave a message about ${item.title}`}
              data-aria-label-en={`Leave a message about ${item.title}`}
              data-aria-label-ru={`Оставить сообщение о ${item.titleRu || item.title}`}
              data-tooltip="Leave a message"
              data-tooltip-en="Leave a message"
              data-tooltip-ru="Оставить сообщение"
              data-tooltip-write-en="Leave a message"
              data-tooltip-write-ru="Оставить сообщение"
              data-tooltip-edit-en="Edit your message"
              data-tooltip-edit-ru="Изменить сообщение"
              hidden
            >
              <Icon name="message" width={16} height={16} />
            </button>
            <button
              class="reserve-btn reserve-btn--loading"
              data-item-id={item.id}
              data-item-title={item.title}
              data-item-title-ru={item.titleRu || item.title}
              data-reservation={item.isReserved ? "other" : "none"}
              data-en-reserve="Reserve"
              data-ru-reserve="Зарезервировать"
              data-en-reserved="Reserved"
              data-ru-reserved="Зарезервировано"
              data-en-cancel="Cancel"
              data-ru-cancel="Отменить"
              data-en-retry="Retry"
              data-ru-retry="Повторить"
              aria-label={
                item.isReserved
                  ? `Cancel reservation for ${item.title}`
                  : `Reserve ${item.title}`
              }
              data-aria-label-en-reserve={`Reserve ${item.title}`}
              data-aria-label-ru-reserve={`Зарезервировать ${item.titleRu || item.title}`}
              data-aria-label-en-cancel={`Cancel reservation for ${item.title}`}
              data-aria-label-ru-cancel={`Отменить резервацию ${item.titleRu || item.title}`}
              data-aria-label-en-reserved={`Reserved: ${item.title}`}
              data-aria-label-ru-reserved={`Зарезервировано: ${item.titleRu || item.title}`}
            >
              {item.isReserved ? "Reserved" : "Reserve"}
            </button>
          </div>
        )
      }
      {
        /* Where a failed reservation says what happened. Empty and hidden until
           there is something to say, on the card that failed rather than in a
           corner of the window — the sentence is about this present, and the
           button it belongs to has just changed back under the reader's cursor.

           role="alert" because it always answers something the visitor did a
           moment ago, and it arrives at the same time as a button silently
           reverting; a polite region can wait until after the next thing they
           read, by which point the revert has no explanation attached to it. */
        !item.received && reservationsEnabled && (
          <p class="reserve-error" role="alert" hidden />
        )
      }
    </div>
  </div>
</article>

<script>
  function initImageLoading() {
    document
      .querySelectorAll<HTMLImageElement>(".wishlist-img")
      .forEach((img) => {
        const container = img.closest(".item-image");
        if (img.complete) {
          container?.classList.add("loaded");
        } else {
          img.addEventListener(
            "load",
            () => {
              container?.classList.add("loaded");
            },
            { once: true },
          );
        }
      });
  }

  initImageLoading();
  document.addEventListener("astro:page-load", initImageLoading);
</script>

<script src="@client/reserve-magnet.ts"></script>
