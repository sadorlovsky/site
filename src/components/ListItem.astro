---
interface Props {
  href?: string;
  interactive?: boolean;
  class?: string;
  tabindex?: number;
}

const { href, interactive = true, class: className, tabindex } = Astro.props;
const Element = href ? "a" : "div";
---

<Element
  class:list={["list-item", { interactive }, className]}
  href={href}
  tabindex={tabindex}
>
  <span class="list-item-date">
    <slot name="date" />
  </span>
  <div class="list-item-content">
    <span class="list-item-title">
      <slot name="title" />
    </span>
    <slot />
  </div>
</Element>

<style>
  /* The accent tokens used to be redeclared here with the same two values
     global.css already holds — the drift that put the wishlist card on its own
     dialect, in miniature. */
  .list-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.5rem 0;
  }

  a.list-item {
    text-decoration: none;
    color: inherit;
  }

  /* The wash a row answers a cursor with is the one the filter chips use — the
     same alpha, the same easing — so "the thing being pointed at" reads the
     same everywhere. It used to be half as strong at a 4px radius, which was
     faint enough that the country tints inside a travel row seemed to appear
     out of nowhere. The radius is generous rather than a capsule: rows wrap to
     several lines, and a 999px pill on a three-line block bows outward. */
  .list-item.interactive {
    padding: 0.5rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 14px;
    transition: background-color 0.25s ease;
  }

  .list-item.interactive:hover {
    background-color: light-dark(rgba(0, 0, 0, 0.055), rgba(255, 255, 255, 0.07));
  }

  .list-item-date {
    font-size: 0.9rem;
    /* The chrome's muted colour. Dark mode had #666, which on a near-black page
       sat right at the edge of legible. */
    color: var(--ink-muted);
  }

  .list-item-title {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink-strong);
    line-height: 1.4;
    transition: all 0.2s ease;
  }

  .list-item-title:empty {
    display: none;
  }

  a.list-item:hover .list-item-title {
    background: var(--accent-gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .list-item-content {
    min-width: 0;
  }

  @media (max-width: 480px) {
    .list-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .list-item-title {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .list-item.interactive,
    .list-item-title {
      transition: none;
    }
  }

  /* The hover paints the title with `-webkit-text-fill-color: transparent`,
     and forced colours does not force that property back — the row under the
     pointer would be the one row with no title. global.css lists
     `.list-item-title` for the same reason, but it cannot win against a scoped
     `a.list-item:hover` selector, so the repaint belongs here too. */
  @media (forced-colors: active) {
    a.list-item:hover .list-item-title {
      background: none;
      -webkit-text-fill-color: currentColor;
    }
  }
</style>
