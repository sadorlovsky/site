---
import { Icon } from "astro-icon/components";
import ProgressBar from "@components/kit/ProgressBar.astro";
import {
  countries,
  countryListSize,
  cities,
  tripsCount,
  continentsVisited,
  continentsTotal,
} from "@lib/travel";
---

<dl class="stats">
  <div class="card">
    <dt data-en="Trips" data-ru="Поездки">Trips</dt>
    <dd class="value">{tripsCount}</dd>
  </div>
  <div class="card">
    <dt data-en="Countries" data-ru="Страны">Countries</dt>
    <dd class="with-info">
      <span class="value">{countries.size} / {countryListSize}</span>
      <a
        href="/travel/countries"
        class="info-link"
        target="_blank"
        aria-label="Why this number? View country list"
        data-aria-label-en="Why this number? View country list"
        data-aria-label-ru="Почему такое число? Посмотреть список стран"
        data-tooltip="Why this number? View country list"
        data-tooltip-en="Why this number? View country list"
        data-tooltip-ru="Почему такое число? Посмотреть список стран"
      >
        <Icon name="question" class="info-icon" aria-hidden="true" />
      </a>
    </dd>
    <ProgressBar
      value={countries.size}
      max={countryListSize}
      label="Countries visited progress"
      data-aria-label-en="Countries visited progress"
      data-aria-label-ru="Прогресс по странам"
      accent
    />
  </div>
  <div class="card">
    <dt data-en="Cities" data-ru="Города">Cities</dt>
    <dd class="value">{cities.size}</dd>
  </div>
  <div class="card">
    <dt data-en="Continents" data-ru="Континенты">Continents</dt>
    <dd class="with-info">
      <span class="value">{continentsVisited} / {continentsTotal}</span>
      <a
        href="https://education.nationalgeographic.org/resource/Continent/"
        class="info-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Why 7 continents? National Geographic definition"
        data-aria-label-en="Why 7 continents? National Geographic definition"
        data-aria-label-ru="Почему 7 континентов? Определение National Geographic"
        data-tooltip="Why 7 continents? National Geographic definition"
        data-tooltip-en="Why 7 continents? National Geographic definition"
        data-tooltip-ru="Почему 7 континентов? Определение National Geographic"
      >
        <Icon name="question" class="info-icon" aria-hidden="true" />
      </a>
    </dd>
    <ProgressBar
      value={continentsVisited}
      max={continentsTotal}
      label="Continents visited progress"
      data-aria-label-en="Continents visited progress"
      data-aria-label-ru="Прогресс по континентам"
      accent
    />
  </div>
</dl>

<script>
  // The "?" links explain the numbers, so they get the site's own tooltip
  // rather than the browser's — which arrives half a second late and in the
  // operating system's styling.
  import { initTooltips } from "@client/tooltip";
  initTooltips();
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    /* The page's own grid gap, so the stats sit on the same rhythm as the map
       and the trip list rather than a tighter one of their own. */
    gap: 1.25rem;
    /* Flush with the content edge, like everything else on the page.
       These cards used to bleed 0.75rem to meet a trip row's hover wash, on
       the argument that everything drawing a surface should end on one line.
       The flaw is that the wash only exists under the pointer: it is a hover
       affordance, not an edge, and aligning a permanent surface to a transient
       one buys agreement nobody is looking at while the stats sit visibly
       wider than the heading above them for the whole rest of the time. */
    margin-inline: 0;
  }

  /* The same material as a wishlist card: tint, border, shadow and rim all from
     the shared tokens, and the same 20px radius so the two read as one family
     of surfaces. It used to be a flat #222222 with a second hardcoded colour
     for the light scheme. */
  .card {
    position: relative;
    background: var(--card-bg);
    border: var(--glass-border);
    border-radius: 20px;
    box-shadow: var(--glass-shadow);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  /* The refractive rim — a lens edge lit from the top left. */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: var(--glass-rim);
  }

  /* These four were <h3>, which put three heading levels on /travel in the
     order h1, h3, h2 — the counters came before the first view's heading and
     announced themselves as sections above it. They are not sections: each is
     a label attached to a number, which is exactly what a description list is
     for, and pairing them properly also means a screen reader reads "Countries,
     47 of 195" instead of two unrelated fragments in sequence.

     The wrapper divs are legal here — a <dl> may group each term-and-value pair
     in a <div> — so the card's material and layout are untouched. */
  .card > dt {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  /* The indent a <dd> arrives with from the browser. */
  .stats dd {
    margin-inline-start: 0;
  }

  .value {
    font-weight: 600;
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .with-info {
    display: inline;
  }

  .info-link {
    position: relative;
    display: inline-flex;
    vertical-align: super;
    padding: 0.1rem;
    border-radius: 999px;
    transition: color 0.2s ease;
  }

  /* The glyph is 17×17 and should stay that way — it is a superscript beside a
     number, and anything larger stops being a footnote and starts competing
     with the figure it belongs to. But 17 is under the 24 a target needs, so
     the target grows instead of the mark: an invisible 24×24 centred on the
     icon, which a finger can hit and an eye never sees.

     Centred by translate rather than by negative insets so it stays square
     whatever the icon's own padding does. */
  .info-link::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
  }

  .info-link:hover .info-icon {
    color: var(--ink-strong);
  }

  .info-link:focus-visible {
    outline: 2px solid var(--focus-ring-on-fill);
    outline-offset: 2px;
  }

  /* Muted like the language switcher's globe — present, not competing with the
     number it belongs to. */
  .info-icon {
    color: var(--ink-muted);
    width: 14px;
    height: 14px;
    transition: color 0.2s ease;
  }

  @media (max-width: 640px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .card {
      padding: 0.75em;
    }

    .value {
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .info-link,
    .info-icon {
      transition: none;
    }
  }
</style>
