---
import type { Trip } from "@lib/travel";
import { formatTripDate, getCountryName, getLandmarkName } from "@lib/travel";
import { getCityName } from "@lib/travel/cities-i18n";
import ListItem from "@components/ListItem.astro";
import styles from "./TravelTripList.module.css";

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;

const getCountryFlag = (code: string) => {
  const parts = code.split("-");
  if (parts.length > 1) {
    return {
      isRegional: true,
      countryCode: parts[0],
      regionCode: code,
    };
  }
  return {
    isRegional: false,
    code: code,
  };
};

// Deterministic hue per country so each country keeps the same tint everywhere.
const countryHue = (code: string) => {
  let h = 0;
  for (let i = 0; i < code.length; i++) h = (h * 31 + code.charCodeAt(i)) % 360;
  return h;
};

const isTba = trip.year === null;
const dateEn = isTba ? "TBA" : formatTripDate(trip, "en");
const dateRu = isTba ? "TBA" : formatTripDate(trip, "ru");

// Landmarks are areal, not route steps, so they get their own muted row beneath
// the journey instead of joining the arrow chain. Aggregated across the trip's
// destinations: splitting them per country would force the countries onto
// separate blocks and break the continuous inline flow the chain relies on.
const tripLandmarks = trip.destinations.flatMap((d) => d.landmarks ?? []);
---

{/*
  The journey is laid out as one continuous inline run so countries fill each
  line (a country tucks into the space left at the end of the previous one's
  last line). Two whitespace-sensitive rules make the wrapping read right, and
  because Astro renders source whitespace literally, the JSX below is written to
  control it byte-for-byte (hence the long, prettier-ignored lines):

    • Every line break is an explicit ZWSP ("\u200b"). A city and its trailing
      arrow are one nowrap unit, so an arrow always trails — never leads — a line.
    • The inter-country arrow (.interSep) hugs the closing </span> of the country
      it leaves with NO whitespace, so it sits OUTSIDE that country's tint yet
      can never strand at the start of a wrapped line. The single space before
      the next country (from this comment's leading whitespace in each fragment)
      is the only break point there, letting the next country fall to a new line.
*/}
<ListItem interactive tabindex={-1} class={styles.tripItem}>
  <span slot="date" data-en={dateEn} data-ru={dateRu}>
    {dateEn}
  </span>
  <div class={styles.destination}>
    {
      trip.destinations.map((destination, destIndex) => {
        const flagInfo = getCountryFlag(destination.country[0]);
        const countryEn = getCountryName(destination.country[1], "en");
        const countryRu = getCountryName(destination.country[1], "ru");
        const hue = countryHue(destination.country[1]);
        const isLastCountry = destIndex === trip.destinations.length - 1;
        const flag = flagInfo.isRegional ? (
          <span class={styles.flagGroup}>
            <span class={[styles.flag, "fi", `fi-${flagInfo.countryCode}`].join(" ")} />
            <span class={styles.flagDivider}>·</span>
            <span class={[styles.flag, "fi", `fi-${flagInfo.regionCode}`].join(" ")} />
          </span>
        ) : (
          // Single flags ride the same flagGroup wrapper as the two-flag case, so
          // both center identically in the tint (a bare inline-block flag sits low
          // and grazes the rounded corner).
          <span class={styles.flagGroup}>
            <span class={[styles.flag, "fi", `fi-${flagInfo.code}`].join(" ")} />
          </span>
        );
        return (
          <Fragment>
            {/* prettier-ignore */}
            <span class={styles.countryGroup} style={`--group-hue: ${hue}`} title={countryEn} data-title-en={countryEn} data-title-ru={countryRu}>{destination.cities.map((city, cityIndex) => {
              const isLastCity = cityIndex === destination.cities.length - 1;
              // The flag rides inside the first city's nowrap unit so "🇦🇹 Vienna"
              // can never split — an inline-block flag otherwise leaves a wrap
              // opportunity after itself and strands at a line end.
              // prettier-ignore
              return (<Fragment><span class={styles.cityUnit}>{cityIndex === 0 && flag}<span class="city-name" data-city={city} data-en={getCityName(city, "en")} data-ru={getCityName(city, "ru")}>{city}</span>{!isLastCity && <span class={styles.separator}>→</span>}</span>{!isLastCity && "\u200b"}</Fragment>);
            })}</span>{!isLastCountry && <span class={styles.interSep}>→</span>}{!isLastCountry && "\u200b"}
          </Fragment>
        );
      })
    }
  </div>
  {
    tripLandmarks.length > 0 && (
      <div class={styles.landmarks}>
        {/* Same mark as the map: a ring with a core. List and map say the
            same thing with the same sign. */}
        <span class={styles.landmarkIcon} aria-hidden="true">
          ◎
        </span>
        {tripLandmarks.map((slug, i) => (
          <Fragment>
            {i > 0 && <span class={styles.landmarkSep}>·</span>}
            <span
              class="landmark-name"
              data-en={getLandmarkName(slug, "en")}
              data-ru={getLandmarkName(slug, "ru")}
            >
              {getLandmarkName(slug, "en")}
            </span>
          </Fragment>
        ))}
      </div>
    )
  }
</ListItem>
