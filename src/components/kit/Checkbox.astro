---
import "@styles/kit/checkbox.css";

export interface Props {
  /** Visual variant */
  variant?: "pill" | "box";
  /** Size variant */
  size?: "sm" | "md";
  /** Name for form submission */
  name?: string;
  /** Value submitted when checked */
  value?: string;
  /** Initial checked state */
  checked?: boolean;
  /** Disabled state */
  disabled?: boolean;
  /** Additional CSS classes */
  class?: string;
}

const {
  variant = "pill",
  size = "md",
  name,
  value,
  checked = false,
  disabled = false,
  class: className,
} = Astro.props;

const classes = [
  "kit-checkbox",
  `kit-checkbox--${variant}`,
  `kit-checkbox--${size}`,
  className,
]
  .filter(Boolean)
  .join(" ");
---

<label class={classes}>
  <input
    class="kit-checkbox__input"
    type="checkbox"
    name={name}
    value={value}
    checked={checked}
    disabled={disabled}
  />
  {
    variant === "box" && (
      <span class="kit-checkbox__box">
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="white"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="2.5 6 5 8.5 9.5 3.5" />
        </svg>
      </span>
    )
  }
  <span class="kit-checkbox__text"><slot /></span>
</label>
