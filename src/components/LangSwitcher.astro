---
import "@styles/kit/toggle-group.css";
import { Icon } from "astro-icon/components";

interface Props {
  /** Runtime mode: the key the chosen language is remembered under. */
  storageKey?: string;
  /**
   * Link mode, for a page that exists once per language rather than swapping
   * its own text — a blog post. Each language is a URL or null when this post
   * has no version in it, and `current` is the one being read.
   *
   * The same capsule either way, deliberately: a reader should not have to
   * learn that the control in the corner means one thing on the archive and
   * another inside a post. What changes is what it is made of — buttons that
   * set a preference, or links that go somewhere.
   */
  links?: { en: string | null; ru: string | null };
  current?: "en" | "ru";
  /** Size variant - sm (32px) or md (38px) */
  size?: "sm" | "md";
}

const { storageKey, links, current = "en", size = "sm" } = Astro.props;

const LANGS = [
  { code: "en" as const, label: "ENG" },
  { code: "ru" as const, label: "РУС" },
];

const missingLabel = {
  en: "This post has no English version",
  ru: "У этого поста нет русской версии",
};

// In link mode the page is written in one language and served in it, so the
// group's own name is written in that language too — there is no LangInit on a
// post to swap it afterwards. In runtime mode the page does change language in
// the browser, and the data-* pair below is what changes this with it.
const groupLabel =
  links && current === "ru" ? "Выбор языка" : "Language selection";
---

<div
  class:list={[
    "kit-toggle-group",
    `kit-toggle-group--${size}`,
    "lang-switcher",
    "liquid-glass",
  ]}
  role="group"
  aria-label={groupLabel}
  data-aria-label-en="Language selection"
  data-aria-label-ru="Выбор языка"
  data-storage-key={storageKey}
>
  <span class="lang-switcher__indicator" aria-hidden="true"></span>
  <Icon
    name="globe"
    class="kit-toggle-group__icon lang-switcher__icon"
    aria-hidden="true"
  />
  {
    links
      ? LANGS.map(({ code, label }) =>
          links[code] ? (
            <a
              class="kit-toggle-item lang-switcher__btn"
              href={links[code]}
              data-lang={code}
              hreflang={code}
              aria-current={code === current ? "page" : undefined}
            >
              {label}
            </a>
          ) : (
            /* The language this post was never written in. Shown rather than
               hidden — a switcher that silently loses half of itself on some
               posts is harder to read than one that says there is nothing on
               the other side. */
            <span
              class="kit-toggle-item lang-switcher__btn is-unavailable"
              data-lang={code}
              aria-disabled="true"
              title={missingLabel[code]}
            >
              {label}
              {/* `aria-disabled` on a `<span>` with no role is exposed to
                  nobody, and a `title` is a tooltip a pointer has to find. The
                  sentence itself, read out with the label, is what says there
                  is nothing on the other side. */}
              <span class="lang-switcher__missing">{missingLabel[code]}</span>
            </span>
          ),
        )
      : LANGS.map(({ code, label }) => (
          <button
            type="button"
            class="kit-toggle-item lang-switcher__btn"
            data-lang={code}
            aria-pressed={code === "en" ? "true" : "false"}
          >
            {label}
          </button>
        ))
  }
</div>

<style>
  /* ===========================================================================
     LangSwitcher — liquid glass pillow with the magnetic glass dock's effect.

     The switcher is its own glass capsule (same recipe as Dock.astro) and shares
     the dock's sliding gradient "magic line": a single indicator slides behind
     the hovered/focused button and rests on the active language. Positioning +
     magnetic hover live in @client/lang-switcher-indicator.ts (modelled on
     nav-dock.ts) so the feel matches the home-page nav exactly.
     =========================================================================== */

  /* Glass shell — the recipe itself comes from the shared .liquid-glass
     utility (global.css). The background is re-declared here through the same
     tokens because the kit's grey `background` shorthand ties .liquid-glass on
     specificity, and this double-class selector settles the fight. Sized to a
     2.7rem content box so it stands exactly as tall as the home pill. */
  .lang-switcher.kit-toggle-group {
    position: relative; /* positioning context for the sliding indicator */
    gap: 0.2rem;
    padding: 0.35rem;
    border-radius: 999px;
    background-color: var(--glass-bg);
    background-image: var(--glass-sheen);
  }

  /* Sliding gradient indicator — the dock's "magic line". Geometry (--ind-*)
     is set by the script; here we mirror the dock indicator's look + easing. */
  .lang-switcher__indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--ind-w, 0);
    height: var(--ind-h, 0);
    border-radius: 999px;
    background: var(--accent-gradient);
    box-shadow: 0 4px 16px rgba(237, 91, 42, 0.45);
    opacity: 0;
    transform: translate(var(--ind-x, 0), var(--ind-y, 0)) scale(calc(1 - 0.1 * var(--lift)));
    transition:
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.42s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
    pointer-events: none;
    z-index: 0;
  }

  .lang-switcher[data-active] .lang-switcher__indicator {
    opacity: 1;
    transform: translate(var(--ind-x, 0), var(--ind-y, 0)) scale(1);
  }

  /* Pill-shaped items — match dock-item geometry and resting colour. 2rem
     tall, like the home glyph, so both capsules share one height. */
  .lang-switcher .lang-switcher__btn {
    position: relative;
    z-index: 1;
    height: 2rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    font-size: 0.72rem;
    color: var(--ink-muted);
    background: transparent;
    box-shadow: none;
    transition: color 0.3s ease;
    will-change: transform; /* magnetic hover */
  }

  /* Neutralise the kit's flat aria-pressed pill — the indicator does the work. */
  .lang-switcher .lang-switcher__btn[aria-pressed="true"] {
    background: transparent;
    box-shadow: none;
  }

  .lang-switcher .lang-switcher__btn:hover {
    color: var(--ink-strong);
  }

  /* Whichever button the indicator rests under — the active language, or the
     one being hovered/focused. Set by the script; mirrors .dock-item.is-active.
     Declared after :hover so it wins on the hovered button (equal specificity). */
  .lang-switcher .lang-switcher__btn.is-active {
    color: var(--accent-ink);
  }

  .lang-switcher .lang-switcher__btn:focus-visible {
    outline: 2px solid var(--focus-ring-on-fill);
    outline-offset: 2px;
  }

  /* Link mode: the anchors carry no underline of their own, and the language
     this post was never written in is present but inert. */
  .lang-switcher a.lang-switcher__btn,
  .lang-switcher a.lang-switcher__btn:visited {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .lang-switcher a.lang-switcher__btn:hover {
    color: var(--ink-strong);
  }

  .lang-switcher a.lang-switcher__btn.is-active,
  .lang-switcher a.lang-switcher__btn[aria-current="page"].is-active {
    color: var(--accent-ink);
  }

  .lang-switcher .lang-switcher__btn.is-unavailable {
    color: var(--ink-muted);
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* Read out, never drawn: the capsule has room for three letters. */
  .lang-switcher__missing {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Globe icon — muted, above the indicator. */
  .lang-switcher .lang-switcher__icon {
    position: relative;
    z-index: 1;
    margin-left: 0.15rem;
    color: var(--ink-muted);
  }

  /* Hide globe icon on narrow screens */
  @media (max-width: 768px) {
    .lang-switcher__icon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switcher__indicator,
    .lang-switcher .lang-switcher__btn {
      transition: none;
    }
  }

  /* Opaque fallback when transparency is reduced — must live here too: the
     glass-token background above out-specifies .liquid-glass's own fallback. */
  @media (prefers-reduced-transparency: reduce) {
    .lang-switcher.kit-toggle-group {
      background-color: light-dark(#f0f0f0, #2a2a2e);
      background-image: none;
    }
  }
</style>

<script is:inline>
  (function () {
    function setLang(storageKey, lang) {
      localStorage.setItem(storageKey, lang);
      // Update html lang attribute for accessibility
      document.documentElement.lang = lang;
      if (lang === "ru") {
        document.documentElement.classList.add("lang-ru");
      } else {
        document.documentElement.classList.remove("lang-ru");
      }
    }

    function applyTranslations(lang) {
      document.querySelectorAll("[data-en][data-ru]").forEach(function (el) {
        var text = el.getAttribute("data-" + lang);
        if (text) el.textContent = text;
      });
      document
        .querySelectorAll("[data-title-en][data-title-ru]")
        .forEach(function (el) {
          var title = el.getAttribute("data-title-" + lang);
          if (title) el.setAttribute("title", title);
        });
      document
        .querySelectorAll("[data-aria-label-en][data-aria-label-ru]")
        .forEach(function (el) {
          var label = el.getAttribute("data-aria-label-" + lang);
          if (label) el.setAttribute("aria-label", label);
        });
      // Matches LangInit's first pass, so tooltips follow a switch mid-page.
      document
        .querySelectorAll("[data-tooltip-en][data-tooltip-ru]")
        .forEach(function (el) {
          var tooltip = el.getAttribute("data-tooltip-" + lang);
          if (tooltip) el.setAttribute("data-tooltip", tooltip);
        });
    }

    function setupLangSwitchers() {
      document.querySelectorAll(".lang-switcher").forEach(function (switcher) {
        var storageKey = switcher.dataset.storageKey;
        if (!storageKey) return;

        var buttons = switcher.querySelectorAll(".lang-switcher__btn");
        var currentLang = localStorage.getItem(storageKey) || "en";

        buttons.forEach(function (btn) {
          btn.setAttribute(
            "aria-pressed",
            btn.dataset.lang === currentLang ? "true" : "false",
          );
        });

        buttons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var lang = btn.dataset.lang;
            if (!lang) return;

            setLang(storageKey, lang);

            buttons.forEach(function (b) {
              b.setAttribute("aria-pressed", b === btn ? "true" : "false");
            });

            applyTranslations(lang);

            window.dispatchEvent(
              new CustomEvent("lang-change", {
                detail: { lang: lang, storageKey: storageKey },
              }),
            );
          });
        });
      });
    }

    setupLangSwitchers();
  })();
</script>

<script src="@client/lang-switcher-indicator.ts"></script>
