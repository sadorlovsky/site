---
import { Icon } from "astro-icon/components";
import LangSwitcher from "@components/LangSwitcher.astro";

interface Props {
  pageTitle: {
    en: string;
    ru: string;
    /** When set, the title is a sub-page crumb (e.g. a post) — no hero title. */
    href?: string;
  };
  subtitle?: {
    en: string;
    ru: string;
  };
  langSwitcher?: string;
  parentLink?: {
    href: string;
    label: { en: string; ru: string };
  };
  forceLang?: "en" | "ru";
  /** Pin the header and condense the hero title into the nav row on scroll. */
  condenseOnScroll?: boolean;
}

const {
  pageTitle,
  subtitle,
  langSwitcher,
  parentLink,
  forceLang,
  condenseOnScroll,
} = Astro.props;

// Use forceLang if provided, otherwise default to "en" (client-side JS updates it).
const displayLang = forceLang || "en";
const pageTitleHref = pageTitle.href;

// Sub-pages (posts) pass pageTitle.href as a crumb — they carry their own title.
const showHeroTitle = !pageTitleHref;
// Show the leaf in the breadcrumb only when it is NOT already the hero title,
// so the page name never appears twice.
const showLeafCrumb = !showHeroTitle;
// No text crumbs at all — render the pill as a clean home button.
const soloCrumb = !parentLink && !showLeafCrumb;
const hasActions = Astro.slots.has("actions");
---

<header
  class:list={["page-header", { "page-header--condense": condenseOnScroll }]}
>
  <div class="header-row">
    <nav
      class:list={["crumbs", { "crumbs--solo": soloCrumb }]}
      aria-label="Breadcrumb"
    >
      <a
        href="/"
        class="crumb-home"
        aria-label="Home"
        data-aria-label-en="Home"
        data-aria-label-ru="Главная"
      >
        <Icon name="home" aria-hidden="true" />
      </a>
      {
        parentLink && (
          <>
            <span class="crumb-sep" aria-hidden="true">
              /
            </span>
            <a
              href={parentLink.href}
              class="crumb-link"
              data-en={parentLink.label.en}
              data-ru={parentLink.label.ru}
            >
              {displayLang === "ru" ? parentLink.label.ru : parentLink.label.en}
            </a>
          </>
        )
      }
      {
        showLeafCrumb && (
          <>
            <span class="crumb-sep" aria-hidden="true">
              /
            </span>
            <a
              href={pageTitleHref}
              class="crumb-current crumb-current--link"
              data-en={pageTitle.en}
              data-ru={pageTitle.ru}
            >
              {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
            </a>
          </>
        )
      }
    </nav>

    {
      condenseOnScroll && showHeroTitle && (
        <span class="condensed-title" aria-hidden="true">
          <span
            class="condensed-title__text"
            data-en={pageTitle.en}
            data-ru={pageTitle.ru}
          >
            {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
          </span>
        </span>
      )
    }

    {
      (langSwitcher || hasActions) && (
        <div class="header-end">
          {langSwitcher && (
            <div class="lang-shell">
              <LangSwitcher storageKey={langSwitcher} />
            </div>
          )}
          <slot name="actions" />
        </div>
      )
    }
  </div>

  {
    condenseOnScroll ? (
      <div class="hero-collapse">
        <div class="hero-collapse__inner">
          {showHeroTitle && (
            <h1 class="page-title" data-en={pageTitle.en} data-ru={pageTitle.ru}>
              {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
            </h1>
          )}
          {subtitle && (
            <p class="subtitle" data-en={subtitle.en} data-ru={subtitle.ru}>
              {displayLang === "ru" ? subtitle.ru : subtitle.en}
            </p>
          )}
          <slot />
        </div>
      </div>
    ) : (
      <>
        {showHeroTitle && (
          <h1 class="page-title" data-en={pageTitle.en} data-ru={pageTitle.ru}>
            {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
          </h1>
        )}
        {subtitle && (
          <p class="subtitle" data-en={subtitle.en} data-ru={subtitle.ru}>
            {displayLang === "ru" ? subtitle.ru : subtitle.en}
          </p>
        )}
        <slot />
      </>
    )
  }
</header>

<style>
  .page-header {
    text-align: left;
    margin: 0;
  }

  .header-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Glass breadcrumb pill */
  .crumbs {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.4rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    background: light-dark(rgba(255, 255, 255, 0.5), rgba(28, 28, 32, 0.45));
    backdrop-filter: blur(16px) saturate(170%);
    border: 1px solid
      light-dark(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.08));
    box-shadow:
      0 10px 30px light-dark(rgba(20, 20, 40, 0.1), rgba(0, 0, 0, 0.35)),
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.07));
    animation: barIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Home-only pill (section landings) — symmetric, reads as a home button. */
  .crumbs--solo {
    padding: 0.35rem;
  }

  .crumb-home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: light-dark(#555, #b4b4b8);
    text-decoration: none;
    transition:
      color 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
    will-change: transform; /* magnetic pull toward the cursor */
  }

  /* Same recipe as the language switcher's gradient indicator: accent fill,
     white glyph, and the identical accent glow. */
  .crumb-home:hover {
    color: #fff;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    box-shadow: 0 4px 16px rgba(237, 87, 96, 0.45);
  }

  .crumb-home :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .crumb-sep {
    color: light-dark(#bbb, #555);
    user-select: none;
  }

  .crumb-link {
    color: light-dark(#666, #999);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: light-dark(#333, #ddd);
  }

  .crumb-current {
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .crumb-current--link {
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .crumb-current--link:hover {
    opacity: 0.75;
  }

  .crumb-home:focus-visible,
  .crumb-link:focus-visible,
  .crumb-current--link:focus-visible {
    outline: 2px solid light-dark(#333, #fff);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Right cluster */
  .header-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* The LangSwitcher carries its own glass capsule now — this is just a plain
     wrapper. The entrance animation is applied to the switcher itself (below),
     NOT here: a transform on this ancestor (even the identity matrix a finished
     transform animation leaves behind) resets the backdrop-filter root and
     silently kills the switcher's glass blur. */
  .lang-shell {
    display: inline-flex;
    align-items: center;
  }

  /* Slide the switcher in, in sync with the breadcrumb pill. Putting the
     animation on the switcher itself (the element that owns the backdrop-filter)
     keeps its blur intact — an element's own transform doesn't break its own
     backdrop, only an ancestor's does. */
  .lang-shell :global(.lang-switcher) {
    animation: barIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Hero title */
  .page-title {
    margin: 1.25rem 0 0 0;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    width: fit-content;
    max-width: 100%;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: light-dark(#666, #999);
    margin: 0.45rem 0 0 0;
    font-weight: 400;
    font-size: 1rem;
  }

  /* ===========================================================================
     Condense-on-scroll mode.

     The header is pinned to the top of the viewport. As the page scrolls the
     hero title collapses (its grid row eases to 0fr) and fades out, while a
     compact copy cross-fades in as its own floating glass pill — centred between
     the home and language pills. Rather than a full-width bar over the page's
     empty dark margins, the condensed header reads as three liquid-glass pills,
     echoing the magnetic glass dock used elsewhere on the site.
     =========================================================================== */
  .page-header--condense {
    position: sticky;
    top: 0;
    z-index: 30;
    transition: padding 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* A whisper more breathing room from the very top edge once the pills float. */
  .page-header--condense.is-condensed {
    padding-top: 0.55rem;
  }

  /* Hero title collapses by easing its grid row from 1fr to 0fr. */
  .page-header--condense .hero-collapse {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .page-header--condense .hero-collapse__inner {
    min-height: 0;
    overflow: hidden;
  }

  .page-header--condense.is-condensed .hero-collapse {
    grid-template-rows: 0fr;
  }

  /* Big hero title fades out as it collapses, so it doesn't double the copy
     that flies up into the pill. */
  .page-header--condense .page-title {
    transition:
      opacity 0.25s ease,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .page-header--condense.is-condensed .page-title {
    opacity: 0;
    transform: translateY(-8px);
  }

  /* Compact title — a floating glass pill centred over the row, hidden until
     condensed. Same liquid-glass recipe as the dock and language switcher. */
  .condensed-title {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, calc(-50% + 8px)) scale(0.96);
    opacity: 0;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1.05rem;
    border-radius: 999px;
    /* Stronger tint than the resting pills: this one floats over the colourful
       map, where a 0.45 wash lets bright land bleed through. A heavier frost
       keeps it reading as glass over any backdrop. (No manual -webkit- prefix —
       it trips Astro's autoprefixer into dropping backdrop-filter entirely.) */
    background: light-dark(rgba(255, 255, 255, 0.65), rgba(26, 26, 30, 0.64));
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid
      light-dark(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.08));
    box-shadow:
      0 10px 30px light-dark(rgba(20, 20, 40, 0.1), rgba(0, 0, 0, 0.35)),
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.07));
    transition:
      opacity 0.35s ease,
      transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The home and language pills also float over the map once condensed — give
     them the same heavier frost so all three read as glass, not wash. Resting
     (expanded) state keeps the lighter site-wide recipe. */
  .page-header--condense.is-condensed .crumbs,
  .page-header--condense.is-condensed
    .lang-shell
    :global(.lang-switcher.kit-toggle-group) {
    background: light-dark(rgba(255, 255, 255, 0.65), rgba(26, 26, 30, 0.64));
    backdrop-filter: blur(20px) saturate(180%);
  }

  .condensed-title__text {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-header--condense.is-condensed .condensed-title {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header--condense,
    .page-header--condense .hero-collapse,
    .page-header--condense .page-title,
    .condensed-title {
      transition: none;
    }
  }

  @keyframes barIn {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crumbs,
    .lang-shell,
    .crumb-home {
      animation: none;
      transition: none;
    }
  }
</style>

<script src="@client/crumb-home-magnet.ts"></script>
<script src="@client/page-header-condense.ts"></script>
