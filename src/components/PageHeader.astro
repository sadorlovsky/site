---
import { Icon } from "astro-icon/components";
import LangSwitcher from "@components/LangSwitcher.astro";

interface Props {
  pageTitle: {
    en: string;
    ru: string;
    /** When set, the title is a sub-page crumb (e.g. a post) — no hero title. */
    href?: string;
  };
  subtitle?: {
    en: string;
    ru: string;
  };
  langSwitcher?: string;
  parentLink?: {
    href: string;
    label: { en: string; ru: string };
  };
  forceLang?: "en" | "ru";
  /** Pin the header and condense the hero title into the nav row on scroll. */
  condenseOnScroll?: boolean;
}

const {
  pageTitle,
  subtitle,
  langSwitcher,
  parentLink,
  forceLang,
  condenseOnScroll,
} = Astro.props;

// Use forceLang if provided, otherwise default to "en" (client-side JS updates it).
const displayLang = forceLang || "en";
const pageTitleHref = pageTitle.href;

// Sub-pages (posts) pass pageTitle.href as a crumb — they carry their own title.
const showHeroTitle = !pageTitleHref;
// Show the leaf in the breadcrumb only when it is NOT already the hero title,
// so the page name never appears twice.
const showLeafCrumb = !showHeroTitle;
// No text crumbs at all — render the pill as a clean home button.
const soloCrumb = !parentLink && !showLeafCrumb;
const hasActions = Astro.slots.has("actions");
---

<header
  class:list={["page-header", { "page-header--condense": condenseOnScroll }]}
>
  {condenseOnScroll && <div class="page-header__veil" aria-hidden="true" />}
  {/* The one row that is on every page and looks the same on all of them, so
      it gets its own view-transition layer instead of being cross-faded along
      with the page body. Without a name the row is captured inside the root
      snapshot at whatever scroll offset it was pinned at, and leaving a
      scrolled page makes the pills appear to jump; named, they hold their
      place while the content underneath changes. There is exactly one
      PageHeader per page, which is what keeps this name unique — two elements
      claiming the same view-transition-name abort the whole transition. */}
  <div class="header-row" transition:name="page-header">
    <nav
      class:list={["crumbs", "liquid-glass", { "crumbs--solo": soloCrumb }]}
      aria-label="Breadcrumb"
    >
      {/* The label is hidden on narrow screens, where `display: none` would
          leave the link with no accessible name at all — so the aria-label
          stays, worded exactly like the visible text. */}
      <a
        href="/"
        class="crumb-home"
        aria-label="Home"
        data-aria-label-en="Home"
        data-aria-label-ru="Домой"
      >
        <Icon name="home" aria-hidden="true" />
        <span class="crumb-home__label" data-en="Home" data-ru="Домой">
          Home
        </span>
      </a>
      {
        parentLink && (
          <>
            <span class="crumb-sep" aria-hidden="true">
              /
            </span>
            <a
              href={parentLink.href}
              class="crumb-link"
              data-en={parentLink.label.en}
              data-ru={parentLink.label.ru}
            >
              {displayLang === "ru" ? parentLink.label.ru : parentLink.label.en}
            </a>
          </>
        )
      }
      {
        showLeafCrumb && (
          <>
            <span class="crumb-sep" aria-hidden="true">
              /
            </span>
            <a
              href={pageTitleHref}
              class="crumb-current crumb-current--link"
              data-en={pageTitle.en}
              data-ru={pageTitle.ru}
            >
              {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
            </a>
          </>
        )
      }
    </nav>

    {/* The pill's accessible name leads with the title written on it, so voice
        control can reach it by what it says — and, less obviously, so it is
        never the bare string "Back to top". Safari 26 treats an element whose
        accessible name is exactly that as a distraction and hides it outright:
        display: none, applied from no stylesheet the page can see, so nothing
        in the DOM explains it. The Russian label ("Наверх") slipped past the
        filter, which is why the condensed title used to appear in Russian and
        vanish in English. Any other wording is fine — the match is exact. */}
    {
      condenseOnScroll && showHeroTitle && (
        <button
          type="button"
          class="condensed-title liquid-glass"
          aria-label={`${pageTitle.en}, back to top`}
          data-aria-label-en={`${pageTitle.en}, back to top`}
          data-aria-label-ru={`${pageTitle.ru}, наверх`}
        >
          <span
            class="condensed-title__text"
            data-en={pageTitle.en}
            data-ru={pageTitle.ru}
          >
            {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
          </span>
        </button>
      )
    }

    {
      (langSwitcher || hasActions) && (
        <div class="header-end">
          {langSwitcher && (
            <div class="lang-shell">
              <LangSwitcher storageKey={langSwitcher} />
            </div>
          )}
          <slot name="actions" />
        </div>
      )
    }
  </div>

  {
    condenseOnScroll ? (
      <div class="page-header__hero">
        {showHeroTitle && (
          /* tabindex -1: the back-to-top pill hands focus here on click, so a
             keyboard user lands at the top of the page rather than nowhere. */
          <h1
            class="page-title"
            tabindex="-1"
            data-en={pageTitle.en}
            data-ru={pageTitle.ru}
          >
            {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
          </h1>
        )}
        {subtitle && (
          <p class="subtitle" data-en={subtitle.en} data-ru={subtitle.ru}>
            {displayLang === "ru" ? subtitle.ru : subtitle.en}
          </p>
        )}
        <slot />
      </div>
    ) : (
      <>
        {showHeroTitle && (
          <h1 class="page-title" data-en={pageTitle.en} data-ru={pageTitle.ru}>
            {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
          </h1>
        )}
        {subtitle && (
          <p class="subtitle" data-en={subtitle.en} data-ru={subtitle.ru}>
            {displayLang === "ru" ? subtitle.ru : subtitle.en}
          </p>
        )}
        <slot />
      </>
    )
  }
</header>

<style>
  .page-header {
    text-align: left;
    margin: 0;
  }

  .header-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Breadcrumb pill — the glass itself comes from the shared .liquid-glass
     utility (global.css); only layout lives here. */
  .crumbs {
    position: relative; /* hosts the .liquid-glass rim */
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem 0.35rem 0.4rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    animation: barIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Home-only pill (section landings) — symmetric, reads as a home button. */
  .crumbs--solo {
    padding: 0.35rem;
  }

  .crumb-home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: none;
    height: 2rem;
    padding: 0 0.7rem 0 0.55rem;
    border-radius: 999px;
    color: light-dark(#555, #b4b4b8);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
    will-change: transform; /* magnetic pull toward the cursor */
  }

  .crumb-home__label {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1;
  }

  /* Narrow screens: the label goes and the pill closes back into a circle.
     Three labelled capsules plus the compact title don't fit a phone, and the
     house on its own is the one glyph nobody needs a word for — the language
     switcher drops its globe at the same width for the same reason. */
  @media (max-width: 600px) {
    .crumb-home {
      width: 2rem;
      padding: 0;
      border-radius: 50%;
    }

    .crumb-home__label {
      display: none;
    }
  }

  /* Same recipe as the language switcher's gradient indicator: accent fill,
     white glyph, and the identical accent glow. */
  .crumb-home:hover {
    color: #fff;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    box-shadow: 0 4px 16px rgba(237, 87, 96, 0.45);
  }

  .crumb-home :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .crumb-sep {
    color: light-dark(#bbb, #555);
    user-select: none;
  }

  .crumb-link {
    color: light-dark(#666, #999);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .crumb-link:hover {
    color: light-dark(#333, #ddd);
  }

  .crumb-current {
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .crumb-current--link {
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .crumb-current--link:hover {
    opacity: 0.75;
  }

  .crumb-home:focus-visible,
  .crumb-link:focus-visible,
  .crumb-current--link:focus-visible {
    outline: 2px solid light-dark(#333, #fff);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Right cluster */
  .header-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* The LangSwitcher carries its own glass capsule now — this is just a plain
     wrapper. The entrance animation is applied to the switcher itself (below),
     NOT here: a transform on this ancestor (even the identity matrix a finished
     transform animation leaves behind) resets the backdrop-filter root and
     silently kills the switcher's glass blur. */
  .lang-shell {
    display: inline-flex;
    align-items: center;
  }

  /* Slide the switcher in, in sync with the breadcrumb pill. Putting the
     animation on the switcher itself (the element that owns the backdrop-filter)
     keeps its blur intact — an element's own transform doesn't break its own
     backdrop, only an ancestor's does. */
  .lang-shell :global(.lang-switcher) {
    animation: barIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* …but only for the document that opened here. Both capsules are chrome:
     identical on every page, and under client-side routing they are still on
     screen when the next page's markup arrives. Sliding them down from -12px
     again would announce a fresh arrival for something that never left. The
     flag is stamped on <html> after each swap (PageLayout.astro). */
  :global(html.is-navigated) .crumbs,
  :global(html.is-navigated) .lang-shell :global(.lang-switcher) {
    animation: none;
  }

  /* Hero title */
  .page-title {
    margin: 1.25rem 0 0 0;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    width: fit-content;
    max-width: 100%;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: light-dark(#666, #999);
    margin: 0.45rem 0 0 0;
    font-weight: 400;
    font-size: 1rem;
  }

  /* ===========================================================================
     Condense-on-scroll mode.

     The pill row pins to the top of the viewport; the hero title is ordinary
     content that scrolls away under it and comes back at exactly the speed the
     page is scrolled. It used to be a state instead — the title's grid row
     eased from 1fr to 0fr once the scroll position crossed a threshold — which
     meant the title only started coming back at y < 6px, after the scroll had
     already stopped, and then took another 400ms. Nothing to wait for now,
     because nothing animates: the title just moves with the page.

     `display: contents` is what makes the pinning possible. A sticky element is
     confined to its parent's box, and this header's box is only as tall as the
     row plus the title — the pills would come unstuck a few hundred pixels
     down. With the header generating no box of its own, the row's containing
     block becomes the page container, so it stays pinned the whole way. It also
     hands the row and the hero to that container's own flex gap, which is why
     the title no longer carries a top margin here.
     =========================================================================== */
  .page-header--condense {
    display: contents;
  }

  .page-header--condense .header-row {
    position: sticky;
    top: 0.55rem;
    z-index: 30;
  }

  /* No margin of its own: with the header's box gone, the row and the hero are
     two items of the page's own container, and its gap already separates them
     exactly as the title's old top margin did. A container without a gap would
     have them touch — the trade for letting the page own its spacing. */
  .page-header--condense .page-title {
    margin-top: 0;
  }

  /* Progressive veil behind the floating pills. The pills leave open gaps where
     page content would otherwise scroll past at full strength; this fixed,
     masked backdrop-blur dissolves whatever approaches the top edge, so rows
     melt away instead of colliding with the capsules.

     It's a real element rather than the row's ::before, and that's the point.
     As a pseudo-element it lived inside the row's stacking context (z-index 30)
     and so painted above everything else pinned to the top — including
     /travel's sticky year, which meant the veil had to stop dead at the year's
     top edge and fade out well before it. That left a band with no veil and no
     year in it, where content scrolled past perfectly sharp. On its own layer
     at z-index 5 it sits above the page but below the year (10) and the pills
     (30), so it can run on behind the year and dissolve there instead. */
  .page-header__veil {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Solid for the strip the pills float over, then a dissolve. On /travel the
       dissolve happens behind the sticky year, which is opaque and covers it, so
       the blur runs unbroken from the top edge to the end of the year's bar;
       with no year docked the same fade is simply a soft bottom. One shape does
       both the tint and the blur — they used to fade on two different curves,
       25% for the colour against 45%-96% for the mask. */
    --veil-fade: 2.75rem;
    height: calc(var(--sticky-header-offset, 5.5rem) + var(--veil-fade));
    pointer-events: none;
    z-index: 5;
    background: var(--veil-bg);
    backdrop-filter: var(--veil-filter);
    mask-image: linear-gradient(
      to bottom,
      black calc(100% - var(--veil-fade)),
      transparent
    );
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .page-header--condense.is-condensed .page-header__veil {
    opacity: 1;
  }

  /* Compact title — a floating glass pill centred over the row, hidden until
     condensed. Shares the .liquid-glass recipe with the home and language
     pills so all three read as one row of identical glass capsules.

     It's also the way back to the top: the page title is exactly the thing you
     reach for when you want the start of the page, and once condensed it sits
     right where the cursor already is. */
  .condensed-title {
    position: absolute;
    left: 50%;
    top: 50%;
    /* Match the home/breadcrumb pill's height (a 2rem glyph + 0.35rem*2
       padding = 2.7rem content box) so all three condensed pills read as one
       row of equally tall glass capsules — content-box keeps the +2px border
       symmetric with .crumbs. */
    min-height: 2.7rem;
    transform: translate(-50%, calc(-50% + 6px)) scale(0.97);
    opacity: 0;
    /* Hidden, not just transparent: an invisible button in the middle of the
       row would still swallow clicks and still take tab focus. Visibility is
       held back until the fade ends so leaving isn't a hard cut. */
    visibility: hidden;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    padding: 0 1.05rem;
    border-radius: 999px;
    font-family: inherit;
    cursor: pointer;
    /* Short, because it starts the moment the title slides under the row —
       while the page is still moving. A long fade would still be running after
       the scroll had stopped, which is the whole thing this replaced. */
    transition:
      opacity 0.22s ease,
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease,
      visibility 0s linear 0.22s;
    will-change: transform, opacity;
  }

  .condensed-title__text {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-header--condense.is-condensed .condensed-title {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, -50%) scale(1);
    transition:
      opacity 0.22s ease,
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease,
      visibility 0s;
  }

  /* Hover lights the rim, the same way the wishlist cards answer a hover —
     the pill doesn't move, because nothing in the chrome scales under a
     cursor. */
  .condensed-title:hover::after,
  .condensed-title:focus-visible::after {
    box-shadow: var(--glass-rim-lit);
  }

  .condensed-title:focus-visible {
    outline: 2px solid light-dark(#333, #fff);
    outline-offset: 2px;
  }

  /* The hero title takes focus after the trip back up; it shouldn't wear a
     focus ring for it, since the whole page is the destination. */
  .page-title:focus {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header__veil,
    .condensed-title {
      transition: none;
    }
  }

  @keyframes barIn {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crumbs,
    .lang-shell,
    .crumb-home {
      animation: none;
      transition: none;
    }
  }
</style>

<script src="@client/crumb-home-magnet.ts"></script>
<script src="@client/page-header-condense.ts"></script>
