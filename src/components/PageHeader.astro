---
import { Icon } from "astro-icon/components";
import LangSwitcher from "@components/LangSwitcher.astro";
import Dock from "@components/Dock.astro";

interface Props {
  pageTitle: {
    en: string;
    ru: string;
    /** When set, the title is a sub-page crumb (e.g. a post) — no hero title. */
    href?: string;
  };
  subtitle?: {
    en: string;
    ru: string;
  };
  langSwitcher?: string;
  /** Kept for backward compatibility; the active section is shown in the dock. */
  parentLink?: {
    href: string;
    label: { en: string; ru: string };
  };
  forceLang?: "en" | "ru";
}

const { pageTitle, subtitle, langSwitcher, forceLang } = Astro.props;

// Use forceLang if provided, otherwise default to "en" (client-side JS updates it).
const displayLang = forceLang || "en";

const navItems = [
  { href: "/travel", en: "Travel", ru: "Путешествия" },
  { href: "/wishlist", en: "Wishlist", ru: "Вишлист" },
  { href: "/blog", en: "Blog", ru: "Блог" },
];

// Sub-pages (posts) pass pageTitle.href as a crumb — they carry their own title.
const showHeroTitle = !pageTitle.href;
const hasActions = Astro.slots.has("actions");
---

<header class="page-header">
  <div class="site-bar">
    <a
      href="/"
      class="home-chip"
      aria-label="Home"
      data-aria-label-en="Home"
      data-aria-label-ru="Главная"
    >
      <Icon name="home" aria-hidden="true" />
    </a>

    <Dock
      bare
      items={navItems}
      activeHref={Astro.url.pathname}
      lang={displayLang}
    />

    {
      (langSwitcher || hasActions) && (
        <div class="site-bar__end">
          {langSwitcher && <LangSwitcher storageKey={langSwitcher} />}
          <slot name="actions" />
        </div>
      )
    }
  </div>

  {
    showHeroTitle && (
      <h1 class="page-title" data-en={pageTitle.en} data-ru={pageTitle.ru}>
        {displayLang === "ru" ? pageTitle.ru : pageTitle.en}
      </h1>
    )
  }
  {
    subtitle && (
      <p class="subtitle" data-en={subtitle.en} data-ru={subtitle.ru}>
        {displayLang === "ru" ? subtitle.ru : subtitle.en}
      </p>
    )
  }
  <slot />
</header>

<style>
  .page-header {
    text-align: left;
    margin: 0;
  }

  /* Glass site bar */
  .site-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: light-dark(rgba(255, 255, 255, 0.5), rgba(28, 28, 32, 0.45));
    backdrop-filter: blur(16px) saturate(170%);
    border: 1px solid
      light-dark(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.08));
    box-shadow:
      0 10px 30px light-dark(rgba(20, 20, 40, 0.1), rgba(0, 0, 0, 0.35)),
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.07));
    animation: barIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .site-bar__end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-right: 0.15rem;
  }

  .home-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: light-dark(#555, #b4b4b8);
    text-decoration: none;
    transition:
      color 0.3s ease,
      background 0.3s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .home-chip:hover {
    color: #fff;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(237, 87, 96, 0.4);
  }

  .home-chip:focus-visible {
    outline: 2px solid light-dark(#333, #fff);
    outline-offset: 2px;
  }

  .home-chip :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* Hero title */
  .page-title {
    margin: 1.25rem 0 0 0;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    width: fit-content;
    max-width: 100%;
    background: linear-gradient(135deg, var(--accent-start), var(--accent-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: light-dark(#666, #999);
    margin: 0.45rem 0 0 0;
    font-weight: 400;
    font-size: 1rem;
  }

  @keyframes barIn {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 520px) {
    .site-bar {
      flex-wrap: wrap;
      gap: 0.35rem;
      border-radius: 1.4rem;
    }

    .site-bar__end {
      padding-right: 0;
    }

    .home-chip {
      width: 2rem;
      height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bar,
    .home-chip {
      animation: none;
      transition: none;
    }
  }
</style>
